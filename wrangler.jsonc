{
	"$schema": "node_modules/wrangler/config-schema.json",
	"assets": {
		"directory": "dist",
		"not_found_handling": "404-page",
	},
	"compatibility_date": "2026-11-18",
	"name": "goldberg-snarks",
	"preview_urls": true,
	"routes": [
		{
			"custom_domain": true,
			"pattern": "goldbergsnarks.com",
		},
	],
	"workers_dev": false,
}
