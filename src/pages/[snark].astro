---
import type { GetStaticPaths } from "astro";

import { render } from "astro:content";

import Article from "~/components/Article.astro";
import Code from "~/components/Code.astro";
import ColoredFigure from "~/components/ColoredFigure.astro";
import EdgePuzzle from "~/components/EdgePuzzle.astro";
import FactBox from "~/components/FactBox.astro";
import Heading from "~/components/Heading.astro";
import LinkedHeading from "~/components/LinkedHeading.astro";
import Snark from "~/components/Snark.astro";
import Term from "~/components/Term.astro";
import Background, { getHeadings } from "~/content/background.mdx";
import { createGoldbergGraph } from "~/graphs/createGoldbergGraph.ts";
import { describeSnark } from "~/graphs/describeSnark.ts";
import { toGraph6 } from "~/graphs/serialize.ts";
import { getGraphs } from "~/getSnarks.ts";
import BaseLayout from "~/layouts/BaseLayout.astro";

export const getStaticPaths = (async () => {
	const graphs = await getGraphs();

	return graphs.map((graph, i) => ({
		params: { snark: graph.href.slice(1) },
		props: { entry: graph, next: graphs[i + 1], previous: graphs[i - 1] },
	}));
}) satisfies GetStaticPaths;

const { entry, next, previous } = Astro.props;
const { blocks, href, isSnark, name, summary } = entry;
const { Content, headings } = await render(entry.entry);
const facts = describeSnark(blocks);
const graph = createGoldbergGraph(blocks);
const title = isSnark ? "Goldberg snark" : "Goldberg graph";

const rows = [
	["Blocks", blocks],
	["Vertices", facts.vertices],
	["Edges", facts.edges],
	["Chromatic index", 4],
	["Resistance", 2],
	["Girth", facts.girth],
	["Circumference", facts.vertices - 1],
	["Cycles of length 5", facts.pentagons],
	["Diameter", facts.diameter],
	["Radius", facts.radius],
	["Symmetries", facts.symmetries],
] as const;

const after = [
	{ depth: 2, slug: "coloring", text: "Edge coloring" },
	{ depth: 2, slug: "downloads", text: "Downloads" },
];
---

<BaseLayout
	description={summary}
	image={{
		alt: `${title} ${name}, beside a drawing of its ${blocks.toString()} blocks in a ring.`,
		path: `/images${href}.png`,
	}}
	schema={{
		"@type": "Article",
		about: { "@type": "Thing", name: `${title} ${name}` },
		headline: `${title} ${name}`,
	}}
	title={`${title} ${name}`}
>
	<Article headings={[...getHeadings(), ...headings, ...after]}>
		<Fragment slot="top">
			<Heading summary={summary}>
				{`${title} `}
				<Snark n={blocks} />
			</Heading>
			<FactBox blocks={blocks} kind={title}>
				<Fragment slot="caption">
					{`The ${title} `}
					<Snark n={blocks} />
				</Fragment>
				{rows.map(([label, value]) => (
					<tr>
						<th scope="row">{label}</th>
						<td>{value}</td>
					</tr>
				))}
				<tr>
					<th scope="row">Crossing number</th>
					<td>
						{facts.crossings ?? `${(blocks * 2).toString()}, conjecturally`}
					</td>
				</tr>
				<tr>
					<th scope="row">Hamiltonian</th>
					<td>
						<a href="/#hamiltonian">No</a>
					</td>
				</tr>
				<tr>
					<th scope="row">Planar</th>
					<td>
						<a href="/#properties">No</a>
					</td>
				</tr>
			</FactBox>
		</Fragment>

		<Background
			blocks={blocks}
			components={{ h2: LinkedHeading }}
			isSnark={isSnark}
		/>

		<Content components={{ h2: LinkedHeading }} />

		<LinkedHeading id="coloring">Edge coloring</LinkedHeading>
		<ColoredFigure
			graph={graph}
			inMargin
			size="small"
			label={`${name} with ${(facts.edges - 2).toString()} of its ${facts.edges.toString()} edges colored ink, blue, or gold. The two uncolored edges are from a1 to b1 and c1 to e1.`}
		>
			<Snark n={blocks} /> with all but <Term is="spare">two edges</Term>{" "}
			colored.
		</ColoredFigure>
		<p>
			Suppose that the edges of <Snark n={blocks} /> could be colored with three
			colors. Then around the ring, the places where the outer and middle links
			have the same color <a href="/#matching">would alternate</a> with the
			places where they have different colors. This is impossible, because there
			are {blocks} such places and {blocks} is odd.
		</p>
		<p>
			At most {facts.edges - 2} of the {facts.edges} edges can be colored,
			because{" "}
			<a href="/#uncolored-edges">at least two must be left uncolored</a>. The
			figure shows one way to do so. There are others.
		</p>
		<EdgePuzzle blocks={blocks} />

		<LinkedHeading id="downloads">Downloads</LinkedHeading>
		<ul class="downloads">
			<li>
				<a download href={`/downloads${href}.svg`}>
					Drawing (SVG)
				</a>
			</li>
			<li>
				<a download href={`/downloads${href}.png`}>
					Drawing (PNG)
				</a>
			</li>
			<li>
				<a download href={`/downloads${href}.txt`}>
					Edge list (text)
				</a>
			</li>
			<li>
				<a download href={`/downloads${href}.g6`}>
					graph6
				</a>
			</li>
		</ul>
		<details>
			<summary>graph6 encoding</summary>
			<Code breaks code={toGraph6(graph)} />
		</details>

		<nav aria-label="Other graphs" class="siblings">
			{previous && (
				<a class="sibling" href={previous.href} rel="prev">
					<span class="direction">Previous</span>
					<Snark n={previous.blocks} />
				</a>
			)}
			{next && (
				<a class="sibling next" href={next.href} rel="next">
					<span class="direction">Next</span>
					<Snark n={next.blocks} />
				</a>
			)}
		</nav>
	</Article>
</BaseLayout>

<style>
	.downloads {
		display: flex;
		flex-wrap: wrap;
		gap: 0.3rem 1.75rem;
		list-style: none;
		margin-bottom: 0.75rem;
		padding: 0;
	}

	.siblings {
		border-top: 1px solid var(--colorRule);
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		justify-content: space-between;
		margin-top: 2.5rem;
		padding-top: 0.75rem;
	}

	.sibling {
		line-height: 1.4;
		text-decoration: none;
	}

	.sibling:hover {
		text-decoration: underline;
	}

	.next {
		margin-left: auto;
		text-align: right;
	}

	.direction {
		color: var(--colorInkMuted);
		display: block;
		font-size: var(--fontSizeSmall);
		font-style: italic;
	}

	@media print {
		.siblings {
			display: none;
		}
	}
</style>
