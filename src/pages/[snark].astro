---
import type { GetStaticPaths } from "astro";

import { render } from "astro:content";

import Article from "~/components/Article.astro";
import Code from "~/components/Code.astro";
import ColoredFigure from "~/components/ColoredFigure.astro";
import EdgePuzzle from "~/components/EdgePuzzle.astro";
import FactBox from "~/components/FactBox.astro";
import Heading from "~/components/Heading.astro";
import LinkedHeading from "~/components/LinkedHeading.astro";
import Snark from "~/components/Snark.astro";
import Term from "~/components/Term.astro";
import Background, { getHeadings } from "~/content/background.mdx";
import { createGoldbergGraph } from "~/graphs/createGoldbergGraph.ts";
import { describeSnark } from "~/graphs/describeSnark.ts";
import { toGraph6 } from "~/graphs/serialize.ts";
import { getGraphs } from "~/getSnarks.ts";
import BaseLayout from "~/layouts/BaseLayout.astro";

export const getStaticPaths = (async () => {
	const graphs = await getGraphs();
	const snarks = graphs.filter(({ isSnark }) => isSnark);

	return graphs.map((graph) => {
		const index = snarks.indexOf(graph);

		return {
			params: { snark: graph.href.slice(1) },
			props: {
				entry: graph,
				next: index === -1 ? undefined : snarks.at(index + 1),
				previous: index > 0 ? snarks[index - 1] : undefined,
			},
		};
	});
}) satisfies GetStaticPaths;

const { entry, next, previous } = Astro.props;
const { blocks, href, isSnark, name, summary } = entry;
const { Content, headings } = await render(entry.entry);
const facts = describeSnark(blocks);
const graph = createGoldbergGraph(blocks);
const title = isSnark ? "Goldberg snark" : "Goldberg graph";

const rows = [
	["Blocks", blocks],
	["Vertices", facts.vertices],
	["Edges", facts.edges],
	["Chromatic index", 4, "/#properties"],
	["Resistance", 2, "/#uncolored-edges"],
	["Girth", facts.girth, "/#properties"],
	["Circumference", facts.vertices - 1, "/#properties"],
	["Cycles of length 5", facts.pentagons, "/#properties"],
	["Diameter", facts.diameter, "/#properties"],
	["Radius", facts.radius, "/#properties"],
	["Symmetries", facts.symmetries, "/#properties"],
] satisfies [string, number, string?][];

const after = [
	{ depth: 2, slug: "coloring", text: "Edge coloring" },
	{ depth: 2, slug: "downloads", text: "Downloads" },
];
---

<BaseLayout
	description={summary}
	image={{
		alt: `${title} ${name}, beside a drawing of its ${blocks.toString()} blocks in a ring.`,
		path: `/images${href}.png`,
	}}
	schema={{
		"@type": "Article",
		about: { "@type": "Thing", name: `${title} ${name}` },
		headline: `${title} ${name}`,
	}}
	title={`${title} ${name}`}
>
	<Article headings={[...getHeadings(), ...headings, ...after]}>
		<Fragment slot="top">
			<Heading summary={summary}>
				{`${title} `}
				<Snark n={blocks} />
			</Heading>
			<FactBox blocks={blocks} kind={title}>
				<Fragment slot="caption">
					{`The ${title} `}
					<Snark n={blocks} />
				</Fragment>
				{rows.map(([label, value, about]) => (
					<tr>
						<th scope="row">{about ? <a href={about}>{label}</a> : label}</th>
						<td>{value}</td>
					</tr>
				))}
				<tr>
					<th scope="row">
						<a href="/#properties">Crossing number</a>
					</th>
					<td>{facts.crossings ?? `${(blocks * 2).toString()}?`}</td>
				</tr>
				<tr>
					<th scope="row">
						<a href="/#hamiltonian">Hamiltonian</a>
					</th>
					<td>No</td>
				</tr>
				<tr>
					<th scope="row">
						<a href="/#properties">Planar</a>
					</th>
					<td>No</td>
				</tr>
			</FactBox>
		</Fragment>

		<Background
			blocks={blocks}
			components={{ h2: LinkedHeading }}
			isSnark={isSnark}
		/>

		<Content components={{ h2: LinkedHeading }} />

		<LinkedHeading id="coloring">Edge coloring</LinkedHeading>
		<ColoredFigure
			graph={graph}
			inMargin
			name={`colored ${name}`}
			size="small"
			label={`${name} with all but two of its ${facts.edges.toString()} edges colored. The uncolored edges are from a1 to b1 and from c1 to e1.`}
		>
			<Snark n={blocks} /> with all but <Term is="spare">two edges</Term>{" "}
			colored.
		</ColoredFigure>
		<p>
			In any 3-edge-coloring, the outer and middle links have the same color on
			one side of each block and different colors on the other side (
			<a href="/#matching">Lemma 4</a>). Around the ring, places between blocks
			where those colors are the same would therefore alternate with places
			where they differ. This is impossible in <Snark n={blocks} />, because
			there are {blocks} places between blocks, and {blocks} is odd.
		</p>
		<p>
			At most {facts.edges - 2} of the {facts.edges} edges can be colored,
			because{" "}
			<a href="/#uncolored-edges">at least two must be left uncolored</a>. The
			figure shows one way to do so. There are others.
		</p>
		<p>
			By Vizing’s theorem, four colors are enough for all of the edges. The
			smallest number of colors in an edge coloring of a graph is its{" "}
			<em>chromatic index</em>, which is 4 for <Snark n={blocks} />. The
			smallest number of edges that must be left uncolored with three colors is
			its <em>resistance</em>, which is 2.
		</p>
		<EdgePuzzle blocks={blocks} />

		<LinkedHeading id="downloads">Downloads</LinkedHeading>
		<ul class="downloads">
			<li>
				<a download href={`/downloads${href}.svg`}>
					Drawing (SVG)
				</a>
			</li>
			<li>
				<a download href={`/downloads${href}.png`}>
					Drawing (PNG)
				</a>
			</li>
			<li>
				<a download href={`/downloads${href}.txt`}>
					Edge list (text)
				</a>
			</li>
			<li>
				<a download href={`/downloads${href}.g6`}>
					Edge list (graph6)
				</a>
			</li>
		</ul>
		<details>
			<summary>Edge list in graph6, a compact text format</summary>
			<Code breaks code={toGraph6(graph)} />
		</details>

		{(previous ?? next) && (
			<nav aria-label="Other Goldberg snarks" class="siblings">
				{previous && (
					<a class="sibling" href={previous.href} rel="prev">
						<span class="direction">Previous</span>
						<Snark n={previous.blocks} />
					</a>
				)}
				{next && (
					<a class="sibling next" href={next.href} rel="next">
						<span class="direction">Next</span>
						<Snark n={next.blocks} />
					</a>
				)}
			</nav>
		)}
	</Article>
</BaseLayout>

<style>
	.downloads {
		display: flex;
		flex-wrap: wrap;
		gap: 0.3rem 1.75rem;
		list-style: none;
		margin-bottom: 0.75rem;
		padding: 0;
	}

	.siblings {
		border-top: 1px solid var(--colorRule);
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		justify-content: space-between;
		margin-top: 2.5rem;
		padding-top: 0.75rem;
	}

	.sibling {
		line-height: 1.4;
		text-decoration: none;
	}

	.sibling:hover {
		text-decoration: underline;
	}

	.next {
		margin-left: auto;
		text-align: right;
	}

	.direction {
		color: var(--colorInkMuted);
		display: block;
		font-size: var(--fontSizeSmall);
		font-style: italic;
	}

	@media print {
		.siblings {
			display: none;
		}
	}
</style>
