---
import type { GetStaticPaths } from "astro";

import { render } from "astro:content";

import Article from "~/components/Article.astro";
import Cite from "~/components/Cite.astro";
import Code from "~/components/Code.astro";
import ColoredFigure from "~/components/ColoredFigure.astro";
import EdgePuzzle from "~/components/EdgePuzzle.astro";
import Hero from "~/components/Hero.astro";
import Snark from "~/components/Snark.astro";
import Term from "~/components/Term.astro";
import WithSnarks from "~/components/WithSnarks.astro";
import { createGoldbergGraph } from "~/graphs/createGoldbergGraph.ts";
import { describeSnark } from "~/graphs/describeSnark.ts";
import { toGraph6 } from "~/graphs/serialize.ts";
import { getSnarks } from "~/getSnarks.ts";
import BaseLayout from "~/layouts/BaseLayout.astro";

export const getStaticPaths = (async () => {
	const snarks = await getSnarks();

	return snarks.map((snark, i) => ({
		params: { snark: snark.href.slice(1) },
		props: { next: snarks[i + 1], previous: snarks[i - 1], snark },
	}));
}) satisfies GetStaticPaths;

const { next, previous, snark } = Astro.props;
const { blocks, href, name, nickname, summary } = snark;
const { Content, headings } = await render(snark.entry);
const facts = describeSnark(blocks);
const graph = createGoldbergGraph(blocks);
const isDisputed = blocks < 5;
const title = isDisputed ? "Goldberg graph" : "Goldberg snark";

const rows = [
	["Blocks", blocks],
	["Vertices", facts.vertices],
	["Edges", facts.edges],
	["Colors for edges (chromatic index)", 4],
	["Edges that three colors can cover", facts.edges - 2],
	["Shortest cycle (girth)", facts.girth],
	["Pentagons", facts.pentagons],
	["Most steps between vertices (diameter)", facts.diameter],
	["Most steps from a center (radius)", facts.radius],
	["Symmetries", facts.symmetries],
	["Longest cycle", facts.vertices - 1],
] as const;

const after = [
	{ depth: 2, slug: "coloring", text: "How far three colors get" },
	{ depth: 2, slug: "try", text: "Try to color it" },
	{ depth: 2, slug: "facts", text: "Facts and figures" },
	{ depth: 2, slug: "downloads", text: "Downloads" },
];
---

<BaseLayout
	description={summary}
	image={{
		alt: `${title} ${name}, beside a drawing of its ${blocks.toString()} blocks in a ring.`,
		path: `/images${href}.png`,
	}}
	schema={{
		"@type": "Article",
		about: { "@type": "Thing", name: `${title} ${name}` },
		headline: `${title} ${name}: ${nickname}`,
	}}
	title={`${title} ${name}: ${nickname}`}
>
	<Hero blocks={blocks}>
		<h1>
			<span class="kind">{title}</span> <Snark n={blocks} />
		</h1>
		<p>
			<WithSnarks text={summary} />
		</p>
		<dl class="glance">
			{(
				[
					["vertices", facts.vertices],
					["edges", facts.edges],
					["symmetries", facts.symmetries],
				] as const
			).map(([label, value]) => (
				<div>
					<dt>{label}</dt>
					<dd>{value}</dd>
				</div>
			))}
		</dl>
	</Hero>

	<Article headings={[...headings, ...after]}>
		<Content />

		<h2 id="coloring">How far three colors get</h2>
		<p>
			There are {blocks} blocks, which is an odd number, so{" "}
			<a href="/#why-three-colors-fail">three colors can’t be enough</a>. One
			edge is never all that’s missing, either. Two can be: here are{" "}
			{facts.edges - 2} of the {facts.edges} edges of <Snark n={blocks} />,
			colored, with all of the <Term is="spare">trouble</Term> in one block.
		</p>
		<ColoredFigure
			graph={graph}
			label={`${name} with ${(facts.edges - 2).toString()} of its ${facts.edges.toString()} edges colored green, blue, or purple. The two left over are from a1 to b1 and c1 to e1.`}
			size="large"
		>
			No coloring of <Snark n={blocks} /> with three colors covers more edges.
		</ColoredFigure>

		<h2 id="try">Try to color it</h2>
		<p>
			There’s more than one way to reach {facts.edges - 2} edges. Can you find
			another?
		</p>
		<EdgePuzzle blocks={blocks} />

		<h2 id="facts">Facts and figures</h2>
		<div class="table facts">
			<table>
				<tbody>
					{rows.map(([label, value]) => (
						<tr>
							<th scope="row">{label}</th>
							<td>{value}</td>
						</tr>
					))}
					<tr>
						<th scope="row">
							Fewest crossings in a drawing <Cite id="weisstein" />
						</th>
						<td>
							{facts.crossings ?? `${(blocks * 2).toString()}, conjecturally`}
						</td>
					</tr>
					<tr>
						<th scope="row">Has a Hamiltonian cycle</th>
						<td>
							<a href="/#hamiltonian">No</a>
						</td>
					</tr>
					<tr>
						<th scope="row">Planar</th>
						<td>
							<a href="/#properties">No</a>
						</td>
					</tr>
				</tbody>
			</table>
		</div>

		<h2 id="downloads">Downloads</h2>
		<ul class="downloads">
			<li>
				<a download href={`/downloads${href}.svg`}>
					Drawing (SVG)
				</a>
			</li>
			<li>
				<a download href={`/downloads${href}.png`}>
					Drawing (PNG)
				</a>
			</li>
			<li>
				<a download href={`/downloads${href}.txt`}>
					Edge list (text)
				</a>
			</li>
			<li>
				<a download href={`/downloads${href}.g6`}>
					Compact encoding (graph6)
				</a>
			</li>
		</ul>
		<details>
			<summary>
				Show its graph6 encoding, for programs such as NetworkX, SageMath, and
				nauty
			</summary>
			<Code breaks code={toGraph6(graph)} />
		</details>

		<nav aria-label="Other snarks" class="siblings">
			{previous ? (
				<a class="sibling" href={previous.href} rel="prev">
					<span class="direction">Previous</span>
					<Snark n={previous.blocks} />
					{`: ${previous.nickname}`}
				</a>
			) : (
				<a class="sibling" href="/">
					<span class="direction">Start from the beginning</span>
					Goldberg snarks
				</a>
			)}
			{next ? (
				<a class="sibling next" href={next.href} rel="next">
					<span class="direction">Next</span>
					<Snark n={next.blocks} />
					{`: ${next.nickname}`}
				</a>
			) : (
				<a class="sibling next" href="/#each-snark">
					<span class="direction">See them all</span>
					Goldberg snarks
				</a>
			)}
		</nav>
	</Article>
</BaseLayout>

<style>
	h1 :global(sub) {
		font-size: 0.6em;
		margin-left: 0;
		vertical-align: -0.18em;
	}

	.kind {
		display: block;
		font-size: 0.5em;
		letter-spacing: -0.01em;
		margin-bottom: 0.3em;
	}

	.glance {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem 2.25rem;
		margin-top: 2rem;
	}

	.glance div {
		display: flex;
		flex-direction: column-reverse;
	}

	.glance dt {
		color: var(--colorMuted);
		font-family: var(--fontLabel);
		font-size: var(--fontSizeSmall);
	}

	.glance dd {
		color: var(--colorForegroundExtra);
		font-size: 1.9rem;
		font-weight: 400;
		line-height: 1.15;
		margin: 0;
	}

	.facts td {
		color: var(--colorForegroundExtra);
		font-weight: 500;
		padding-right: 0;
		text-align: right;
	}

	.downloads {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 2rem;
		list-style: none;
		margin-bottom: 1.25rem;
		padding: 0;
	}

	summary {
		cursor: pointer;
	}

	@media print {
		.siblings {
			display: none;
		}
	}

	.siblings {
		border-top: 1px solid var(--colorRule);
		display: flex;
		flex-wrap: wrap;
		gap: 1.5rem;
		justify-content: space-between;
		margin-top: 5rem;
		padding-top: 1.5rem;
	}

	.sibling {
		font-weight: 500;
		line-height: 1.4;
	}

	.next {
		text-align: right;
		margin-left: auto;
	}

	.direction {
		color: var(--colorMuted);
		display: block;
		font-family: var(--fontLabel);
		font-size: var(--fontSizeSmall);
		font-weight: 400;
	}
</style>
