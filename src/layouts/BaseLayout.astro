---
import { Font } from "astro:assets";

import Footer from "~/components/Footer.astro";
import Header from "~/components/Header.astro";

import "~/styles/global.css";

interface Props {
	description: string;

	/** Path of the image for links to this page, and what's in it. */
	image: { alt: string; path: string };

	/** What's said about the page to search engines, per schema.org. */
	schema?: Record<string, unknown>;

	title: string;
}

const { description, image, schema, title } = Astro.props;
const imageUrl = new URL(image.path, Astro.site);
const pageUrl = new URL(Astro.url.pathname.replace(/(.)\/$/, "$1"), Astro.site);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta content="width=device-width, initial-scale=1" name="viewport" />
		<title>{title}</title>
		<meta content={description} name="description" />
		<link href={pageUrl} rel="canonical" />
		<link href="/favicon.svg" rel="icon" type="image/svg+xml" />
		<link href="/sitemap-index.xml" rel="sitemap" />
		<meta
			content="#ecf4f9"
			media="(prefers-color-scheme: light)"
			name="theme-color"
		/>
		<meta
			content="#0b1220"
			media="(prefers-color-scheme: dark)"
			name="theme-color"
		/>
		<meta content="article" property="og:type" />
		<meta content="Goldberg snarks" property="og:site_name" />
		<meta content={title} property="og:title" />
		<meta content={description} property="og:description" />
		<meta content={pageUrl} property="og:url" />
		<meta content={imageUrl} property="og:image" />
		<meta content="1200" property="og:image:width" />
		<meta content="630" property="og:image:height" />
		<meta content={image.alt} property="og:image:alt" />
		<meta content="summary_large_image" name="twitter:card" />
		<Font
			cssVariable="--fontDisplay"
			preload={[{ style: "normal", subset: "latin" }]}
		/>
		<Font
			cssVariable="--fontText"
			preload={[{ style: "normal", subset: "latin" }]}
		/>
		<Font cssVariable="--fontLabel" />
		<script is:inline>
			// Before first paint, so as to not flash the other theme
			try {
				const theme = localStorage.getItem("theme");

				if (theme === "dark" || theme === "light") {
					document.documentElement.dataset.theme = theme;
				}
			} catch {
				// Browsers may block storage
			}
		</script>
		{schema && (
			<script
				is:inline
				set:html={JSON.stringify({
					"@context": "https://schema.org",
					author: {
						"@type": "Person",
						name: "Josh Goldberg",
						url: "https://www.joshuakgoldberg.com",
					},
					description,
					inLanguage: "en",
					url: pageUrl,
					...schema,
				})}
				type="application/ld+json"
			/>
		)}
	</head>
	<body>
		<a class="skip" href="#main">
			Skip to content
		</a>
		<Header />
		<main id="main">
			<slot />
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		margin-inline: auto;
		max-width: calc(var(--widthFull) + 2 * var(--space));
		padding-inline: var(--space);
	}

	.skip {
		background: var(--colorRaised);
		left: 1rem;
		padding: 0.5rem 1rem;
		position: absolute;
		top: -5rem;
		z-index: 1;
	}

	.skip:focus {
		top: 1rem;
	}
</style>
