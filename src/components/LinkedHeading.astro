---
interface Props {
	id: string;
	level?: "h2" | "h3";
}

const { id, level: Level = "h2" } = Astro.props;
---

<Level id={id}>
	<a class="anchor" href={`#${id}`}>
		<slot />
	</a>
</Level>

<style>
	.anchor {
		color: inherit;
		text-decoration: none;
	}

	.anchor::after {
		color: var(--colorRed);
		content: "\00a0#" / "";
		opacity: 0;
	}

	.anchor:is(:hover, :focus-visible)::after,
	:target > .anchor::after {
		opacity: 1;
	}

	.anchor:hover,
	:target > .anchor {
		color: var(--colorRed);
	}
</style>
