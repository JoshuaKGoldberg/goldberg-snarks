---
import { getSnarks } from "~/getGraphs.ts";
import { describeGraph } from "~/graphs/describeGraph.ts";

import Snark from "./Snark.astro";

const snarks = await getSnarks();
---

{/* Anything that scrolls needs to be focusable to be scrolled with a keyboard */}
{/* eslint-disable astro/jsx-a11y/no-noninteractive-tabindex */}
<div
	aria-label="Comparison of Goldberg snarks"
	class="table wide"
	role="region"
	tabindex="0"
>
	<table>
		<thead>
			<tr>
				<th scope="col">Snark</th>
				<th scope="col">Vertices</th>
				<th scope="col">Edges</th>
				<th scope="col">Cycles of length 5</th>
				<th scope="col">Diameter</th>
				<th scope="col">Radius</th>
				<th scope="col">Symmetries</th>
				<th scope="col">Crossing number</th>
			</tr>
		</thead>
		<tbody>
			{snarks.map(({ blocks, href }) => {
				const facts = describeGraph(blocks);

				return (
					<tr>
						<th scope="row">
							<a href={href}>
								<Snark n={blocks} />
							</a>
						</th>
						<td>{facts.vertices}</td>
						<td>{facts.edges}</td>
						<td>{facts.pentagons}</td>
						<td>{facts.diameter}</td>
						<td>{facts.radius}</td>
						<td>{facts.symmetries}</td>
						<td>
							{facts.crossings}
							{!facts.isCrossingsKnown && "?"}
						</td>
					</tr>
				);
			})}
		</tbody>
	</table>
</div>
{/* eslint-enable astro/jsx-a11y/no-noninteractive-tabindex */}

<style>
	:is(td, th) {
		min-width: 3.2rem;
	}

	:is(td, th):not(:first-child) {
		text-align: right;
	}

	:is(td, th):last-child {
		padding-right: 2px;
	}
</style>
