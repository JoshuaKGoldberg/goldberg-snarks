---
import type { Role } from "~/graphs/block.ts";

import Vertex from "./Vertex.astro";

interface Props {
	edges: readonly { from: Role; to: Role }[];

	/** Which block each second vertex is in. */
	to: string;
}

const { edges, to } = Astro.props;
---

<span class="formulas">
	{edges.map((edge) => (
		<span>
			<Vertex i="i" role={edge.from} />
			<Vertex i={to} role={edge.to} />,
		</span>
	))}
</span>

<style>
	.formulas {
		display: flex;
		flex-wrap: wrap;
		gap: 0.1rem 0.8rem;
	}
</style>
