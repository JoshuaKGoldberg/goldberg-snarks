---
import type { ComponentProps } from "astro/types";

import { type Coloring } from "~/graphs/colorEdges.ts";
import { getColorClass } from "~/graphs/edgeClasses.ts";

import ColoringKey from "./ColoringKey.astro";
import Figure from "./Figure.astro";
import MovableDrawing from "./MovableDrawing.astro";

type Props = ComponentProps<typeof Figure> &
	Pick<
		ComponentProps<typeof MovableDrawing>,
		"cropped" | "graph" | "label" | "name"
	> & {
		coloring: Coloring;
	};

const { coloring, cropped, graph, label, name, ...figure } = Astro.props;
---

<Figure {...figure}>
	<MovableDrawing
		cropped={cropped}
		edgeClass={(index) => getColorClass(coloring[index])}
		graph={graph}
		label={label}
		name={name}
		slot="drawing"
	/>
	<ColoringKey slot="key" spare={coloring.includes(undefined)} />
	<slot />
</Figure>
