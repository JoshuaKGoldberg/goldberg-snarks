---
import type { Graph } from "~/graphs/types.ts";

import { colorMostEdges } from "~/graphs/colorEdges.ts";
import { getColorClass } from "~/graphs/edgeClasses.ts";

import ColoringKey from "./ColoringKey.astro";
import MovableDrawing from "./MovableDrawing.astro";
import Figure from "./Figure.astro";

interface Props {
	graph: Graph;
	inMargin?: boolean;
	label: string;
	size?: "large" | "medium" | "small";

	/** Indices of two edges to leave uncolored if needed, other than the usual. */
	spares?: Set<number>;
}

const { graph, inMargin, label, size, spares } = Astro.props;
const coloring = colorMostEdges(graph, spares);
---

<Figure inMargin={inMargin} size={size}>
	<MovableDrawing
		slot="drawing"
		edgeClass={(index) => getColorClass(coloring[index])}
		graph={graph}
		label={label}
	/>
	<ColoringKey slot="key" spare={coloring.includes(undefined)} />
	<slot />
</Figure>
