---
import { colorMostEdges } from "~/graphs/colorEdges.ts";
import { createGoldbergGraph } from "~/graphs/createGoldbergGraph.ts";
import { getColorClass, getPartClass } from "~/graphs/edgeClasses.ts";

import Drawing from "./Drawing.astro";

interface Props {
	blocks: number;
	colored?: boolean | undefined;
}

const { blocks, colored } = Astro.props;
const graph = createGoldbergGraph(blocks);
const coloring = colored ? colorMostEdges(graph) : undefined;
const kind = blocks < 5 ? "graph" : "snark";
const label = `The Goldberg ${kind} G${blocks.toString()}: ${blocks.toString()} identical blocks of vertices and edges in a ring around a central ${blocks.toString()}-sided loop.${colored ? " Its edges are colored with three colors, except for two that are left over." : ""}`;
---

<div class="hero-drawing">
	<Drawing
		edgeClass={(index) =>
			coloring ? getColorClass(coloring[index]) : getPartClass(graph, index)
		}
		graph={graph}
		grows
		label={label}
		padding={3}
	/>
</div>

<style>
	.hero-drawing {
		aspect-ratio: 1;
		margin: auto;
		max-width: 30rem;
		padding: 9.5%;
		position: relative;
		width: 100%;
	}

	/* A pale disc of light */
	.hero-drawing::before {
		background: radial-gradient(
			closest-side,
			light-dark(white, #16213a) 35%,
			light-dark(rgb(255 255 255 / 55%), #101a2e) 100%
		);
		border-radius: 50%;
		box-shadow: 0 0 5rem 1rem
			light-dark(rgb(255 255 255 / 85%), rgb(56 130 255 / 9%));
		content: "";
		inset: 0;
		position: absolute;
		z-index: -1;
	}

	/* A polished rim: bright where light catches it, tinted everywhere else */
	.hero-drawing::after {
		--shine: light-dark(#c5ecff, #dff3ff);

		background: conic-gradient(
			from 300deg,
			var(--shine),
			#4fa8f2 12%,
			#a56cf0 28%,
			var(--shine) 42%,
			#f573a4 52%,
			#a56cf0 64%,
			#36cfa2 80%,
			var(--shine)
		);
		border-radius: 50%;
		content: "";
		inset: 0;
		mask: radial-gradient(
			closest-side,
			transparent calc(100% - 2.5px),
			black calc(100% - 2px)
		);
		opacity: 0.75;
		pointer-events: none;
		position: absolute;
	}

	@media print {
		.hero-drawing::after,
		.hero-drawing::before {
			display: none;
		}
	}
</style>
