---
import {
	createPetersenAroundBlock,
	isCut,
} from "~/graphs/createPetersenAroundBlock.ts";
import { getColorClass } from "~/graphs/edgeClasses.ts";

import ColoringKey from "../ColoringKey.astro";
import Figure from "../Figure.astro";
import MovableDrawing from "../MovableDrawing.astro";
import { nameFlatVertices } from "./names.ts";

const graph = createPetersenAroundBlock();

/** Colors of the edges that were cut, by the names of their vertices. */
const colors: Record<string, number> = {
	bv: 0,
	eu: 0,
	fw: 0,
	gw: 1,
	hu: 2,
	uv: 1,
	vw: 2,
};

const getName = (index: number) => {
	const { from, to } = graph.edges[index];

	return [graph.vertices[from].name, graph.vertices[to].name].sort().join("");
};
---

<Figure inMargin>
	<MovableDrawing
		cropped
		edgeClass={(index) =>
			isCut(graph, index) ? getColorClass(colors[getName(index)]) : "faint"
		}
		graph={graph}
		label="The Petersen graph, drawn as before. The edges from b to v, e to u, and f to w are green; those from g to w and u to v are blue; and those from h to u and v to w are gold."
		name="Reattached block"
		names={nameFlatVertices(graph)}
		nameSize={11}
		padding={17}
		slot="drawing"
	/>
	<ColoringKey slot="key" />
	<slot />
</Figure>
