---
import { createGoldbergGraph } from "~/graphs/createGoldbergGraph.ts";
import { getPartClass } from "~/graphs/edgeClasses.ts";

import Figure from "../Figure.astro";
import MovableDrawing from "../MovableDrawing.astro";
import { nameRingVertices } from "./names.ts";

const graph = createGoldbergGraph(5);
---

<Figure size="large">
	<MovableDrawing
		edgeClass={(index) => getPartClass(graph, index)}
		graph={graph}
		label="The Goldberg snark G5: five blocks in a ring. The outer and middle rings each pass through ten vertices, and the inner ring passes through five, in the center. The vertices of the block at the top are labeled a1 through h1."
		name="Labeled G5"
		names={nameRingVertices}
		nameSize={7.5}
		padding={8}
		slot="drawing"
	/>
	<slot />
</Figure>
