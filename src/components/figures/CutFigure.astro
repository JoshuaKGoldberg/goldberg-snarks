---
import {
	createPetersenAroundBlock,
	isCut,
} from "~/graphs/createPetersenAroundBlock.ts";

import Figure from "../Figure.astro";
import MovableDrawing from "../MovableDrawing.astro";
import { nameFlatVertices } from "./names.ts";

const graph = createPetersenAroundBlock();
---

<Figure id="cut" inMargin>
	<MovableDrawing
		cropped
		edgeClass={(index) => (isCut(graph, index) ? "cut" : "spoke")}
		graph={graph}
		label="The Petersen graph, drawn as a block’s vertices b through h, with three more vertices: u, joined to e, h, and v; v, joined to b, u, and w; and w, joined to f, g, and v."
		name="Block within the Petersen graph"
		names={nameFlatVertices(graph)}
		nameSize={11}
		padding={17}
		slot="drawing"
	/>
	<slot />
</Figure>
