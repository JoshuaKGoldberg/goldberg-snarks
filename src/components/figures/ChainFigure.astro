---
import { requireColoring, spareEdges } from "~/graphs/colorEdges.ts";
import { createBlockChain, getLooseLinks } from "~/graphs/createBlockChain.ts";

import ColoredFigure from "../ColoredFigure.astro";

interface Props {
	blocks: number;
	id?: string;
	label: string;

	/** Colors of the inner, outer, and middle links, which are the same on both sides. */
	links: readonly number[];
	name: string;

	/** Whether to leave two edges of the first block uncolored. */
	spares?: boolean;
}

const { blocks, id, label, links, name, spares } = Astro.props;
const graph = createBlockChain(blocks);
const coloring = requireColoring(graph, {
	fixed: new Map(
		getLooseLinks(graph).map((link, i) => [link, links[i % links.length]]),
	),
	...(spares && { skipped: spareEdges }),
});
---

<ColoredFigure
	coloring={coloring}
	cropped
	graph={graph}
	id={id}
	label={label}
	name={name}
>
	<slot />
</ColoredFigure>
