---
import { createBlockChain } from "~/graphs/createBlockChain.ts";
import { getPartClass } from "~/graphs/edgeClasses.ts";

import Figure from "../Figure.astro";
import MovableDrawing from "../MovableDrawing.astro";
import { nameFlatVertices } from "./names.ts";

const graph = createBlockChain(1);
---

<Figure inMargin size="small">
	<MovableDrawing
		cropped
		edgeClass={(index) => getPartClass(graph, index)}
		graph={graph}
		label="A block: eight vertices, a through h. Edges join a to b; b to c and d; c to e and g; d to f and h; e to f; and g to h. Links lead left from f, g, and a, and right from e, h, and a."
		name="Block"
		names={nameFlatVertices(graph)}
		nameSize={10}
		padding={17}
		slot="drawing"
	/>
	<slot />
</Figure>
