---
import { type Reference, references } from "~/references.ts";

const entries: [string, Reference][] = Object.entries(references);
const sorted = entries.sort(([, a], [, b]) =>
	a.authors
		.replace(/^(?:[A-Z]\. ?)+/, "")
		.localeCompare(b.authors.replace(/^(?:[A-Z]\. ?)+/, "")),
);
---

<ol>
	{sorted.map(([id, { authors, details, href, title, year }]) => (
		<li id={id}>
			{year ? `${authors} (${year.toString()}). ` : `${authors}. `}
			<a href={href}>{title}</a>
			{`. ${details}`}
		</li>
	))}
</ol>

<style>
	ol {
		font-size: 0.9375rem;
		line-height: 1.4;
		list-style: none;
		padding: 0;
	}

	li {
		padding-block: 0.22rem;
		padding-left: 1.5rem;
		text-indent: -1.5rem;
	}

	li:target {
		background: var(--colorPaperShaded);
	}

	a {
		font-style: italic;
	}
</style>
