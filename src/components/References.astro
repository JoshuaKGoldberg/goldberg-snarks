---
import { type Reference, references } from "~/references.ts";

const sorted = Object.entries<Reference>(references).sort(([, a], [, b]) =>
	getLastName(a).localeCompare(getLastName(b)),
);

function getLastName({ authors }: Reference) {
	return authors.replace(/^(?:[A-Z]\. ?)+/, "");
}
---

<ol>
	{sorted.map(([id, { authors, details, href, lang, title, year }]) => (
		<li id={id}>
			{year ? `${authors} (${year.toString()}). ` : `${authors}. `}
			{href ? <a href={href}>{title}</a> : <i lang={lang}>{title}</i>}
			{`. ${details}`}
		</li>
	))}
</ol>

<style>
	ol {
		font-size: var(--fontSizeNote);
		line-height: 1.4;
		list-style: "";
		padding: 0;
	}

	li {
		background: color-mix(
			in srgb,
			var(--colorPaperShaded) var(--lit),
			transparent
		);
		padding-block: 0.22rem;
		padding-left: 1.5rem;
		text-indent: -1.5rem;
		transition: --lit var(--quickly);
	}

	li:target {
		--lit: 100%;
	}

	a {
		font-style: italic;
	}
</style>
