---
interface Props {
	id?: string;

	/** Whether the figure goes beside the text when there's room for it to. */
	inMargin?: boolean;
	size?: "large" | "medium" | "small";
}

const { id, inMargin, size = "medium" } = Astro.props;
---

<figure class:list={[inMargin && "in-margin"]} id={id}>
	<div class:list={["drawing", size]}>
		<slot name="drawing" />
	</div>
	<slot name="key" />
	<figcaption>
		<slot />
	</figcaption>
</figure>

<style>
	figure {
		counter-increment: figure;
		display: grid;
		gap: 0.6rem;
		grid-template-columns: minmax(0, 1fr);
		margin-block: 1.25rem;
	}

	.drawing {
		margin: 0 auto;
		width: 100%;
	}

	.large {
		max-width: 25rem;
	}

	.medium {
		max-width: 22rem;
	}

	.small {
		max-width: 14rem;
	}

	figcaption {
		color: var(--colorInkMuted);
		font-size: 0.9375rem;
		line-height: 1.4;
		margin-inline: auto;
		max-width: 30rem;
		text-align: center;
		text-wrap: balance;
	}

	figcaption::before {
		color: var(--colorRed);
		content: "Figure " counter(figure) ". ";
		font-style: italic;
	}

	figcaption > :global(p) {
		display: inline;
		text-wrap: inherit;
	}

	figure:target {
		box-shadow: 0 0 0 0.5rem var(--colorPaperShaded);
		background: var(--colorPaperShaded);
	}

	@media (min-width: 60rem) {
		.in-margin {
			clear: right;
			float: right;
			margin: 0.25rem calc(-1 * var(--outset)) 1.75rem 0;
			width: var(--widthMargin);
		}
	}

	@media print {
		figure {
			break-inside: avoid;
		}
	}
</style>
