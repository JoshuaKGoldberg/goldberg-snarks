---
interface Props {
	id?: string;
	size?: "large" | "medium" | "small";
}

const { id, size = "medium" } = Astro.props;
---

<figure id={id}>
	<div class:list={["drawing", size]}>
		<slot name="drawing" />
	</div>
	<slot name="key" />
	<figcaption>
		<slot />
	</figcaption>
</figure>

<style>
	figure {
		counter-increment: figure;
		display: grid;
		gap: 1rem;
		margin-block: 2.75rem;
	}

	.drawing {
		margin: 0 auto 0.25rem;
		width: 100%;
	}

	.large {
		max-width: 34rem;
	}

	.medium {
		max-width: 26rem;
	}

	.small {
		max-width: 18rem;
	}

	figcaption {
		color: var(--colorMuted);
		font-size: 0.9em;
		line-height: 1.45;
		margin-inline: auto;
		max-width: 34rem;
		text-align: center;
		text-wrap: balance;
	}

	figcaption::before {
		color: var(--colorForegroundExtra);
		content: "Figure " counter(figure) ". ";
		font-weight: 500;
	}

	figcaption > :global(p) {
		display: inline;
		text-wrap: inherit;
	}

	@media print {
		figure {
			break-inside: avoid;
		}
	}
</style>
