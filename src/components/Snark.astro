---
interface Props {
	/** Number of blocks, or a variable for it. */
	n: number | string;
}

const { n } = Astro.props;
---

<span class="snark">
	<i>G</i>
	<sub>{typeof n === "number" ? n : <i>{n}</i>}</sub>
</span>

<style>
	.snark {
		white-space: nowrap;
	}

	/* The display font has no italics of its own */
	:is(h1, h2, h3) i {
		font-family: var(--fontText);
		font-weight: 400;
	}

	sub {
		font-feature-settings: "lnum";
		margin-left: 0.05em;
	}
</style>
