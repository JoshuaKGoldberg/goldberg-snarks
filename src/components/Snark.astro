---
interface Props {
	/** Number of blocks, or a variable for it. */
	n: number | string;
}

const { n } = Astro.props;
---

<span class="snark">
	<i>G</i>
	<sub>{typeof n === "number" ? n : <i>{n}</i>}</sub>
</span>

<style>
	.snark {
		white-space: nowrap;
	}

	sub {
		font-feature-settings: "lnum";
		margin-left: 0.05em;
	}
</style>
