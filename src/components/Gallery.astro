---
import { createGoldbergGraph } from "~/graphs/createGoldbergGraph.ts";
import { getPartClass } from "~/graphs/edgeClasses.ts";
import { getSnarks } from "~/getSnarks.ts";

import Drawing from "./Drawing.astro";
import Snark from "./Snark.astro";
import WithSnarks from "./WithSnarks.astro";

const snarks = await getSnarks();
---

<ul class="gallery">
	{snarks.map(({ blocks, href, teaser }) => {
		const graph = createGoldbergGraph(blocks);

		return (
			<li>
				<a class="plate" href={href}>
					<Drawing
						edgeClass={(index) => getPartClass(graph, index)}
						graph={graph}
						padding={2}
					/>
					<span class="name">
						<Snark n={blocks} />
					</span>
					<span class="teaser">
						<WithSnarks text={teaser} />
					</span>
				</a>
			</li>
		);
	})}
</ul>

<style>
	.gallery {
		--columns: 2;
		--gap: 1rem;

		display: flex;
		flex-wrap: wrap;
		gap: 0.9rem var(--gap);
		justify-content: center;
		list-style: none;
		margin-block: 1rem;
		padding: 0;
	}

	li {
		width: calc((100% - (var(--columns) - 1) * var(--gap)) / var(--columns));
	}

	.plate {
		color: inherit;
		display: grid;
		line-height: 1.3;
		text-align: center;
		text-decoration: none;
	}

	.plate :global(.graph path:not(.dots)) {
		stroke-width: 1px;
	}

	.name {
		color: var(--colorRed);
		font-size: 1.1875rem;
		margin-top: 0.3rem;
	}

	.teaser {
		color: var(--colorInkMuted);
		font-size: 0.875rem;
		text-wrap: balance;
	}

	.plate:hover .name {
		text-decoration: underline;
		text-underline-offset: 0.17em;
	}

	@media (min-width: 34rem) {
		.gallery {
			--columns: 3;
		}
	}
</style>
