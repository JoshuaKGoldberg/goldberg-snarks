---
import { getSnarks } from "~/getGraphs.ts";
import { createGoldbergGraph } from "~/graphs/createGoldbergGraph.ts";
import { getPartClass } from "~/graphs/edgeClasses.ts";

import Drawing from "./Drawing.astro";
import Snark from "./Snark.astro";

const snarks = await getSnarks();
---

<ul class="gallery">
	{snarks.map(({ blocks, href }) => {
		const graph = createGoldbergGraph(blocks);

		return (
			<li>
				<a class="plate" href={href}>
					<Drawing
						edgeClass={(index) => getPartClass(graph, index)}
						graph={graph}
						padding={2}
					/>
					<span class="name">
						<Snark n={blocks} />
					</span>
					<span class="teaser">{graph.vertices.length} vertices</span>
				</a>
			</li>
		);
	})}
</ul>

<style>
	.gallery {
		--columns: 2;
		--gap: 1rem;

		display: flex;
		flex-wrap: wrap;
		gap: 0.9rem var(--gap);
		justify-content: center;
		list-style: "";
		margin-block: 1rem;
		padding: 0;
	}

	li {
		break-inside: avoid;
		width: calc((100% - (var(--columns) - 1) * var(--gap)) / var(--columns));
	}

	.plate {
		color: inherit;
		display: grid;
		line-height: 1.3;
		text-align: center;
		text-decoration: none;
	}

	.plate :global(.graph path:not(.dots)) {
		stroke-width: 1px;
	}

	.name {
		color: var(--colorRed);
		font-size: var(--fontSizeSubheading);
		margin-top: 0.3rem;
		text-decoration: underline
			color-mix(in srgb, currentcolor var(--lit), transparent);
		text-underline-offset: 0.17em;
		transition: --lit var(--quickly);
	}

	.teaser {
		color: var(--colorInkMuted);
		font-size: var(--fontSizeSmall);
		text-wrap: balance;
	}

	@media (hover: hover) {
		.plate:hover .name {
			--lit: 100%;
		}
	}

	@media (width >= 34rem) {
		.gallery {
			--columns: 3;
		}
	}
</style>
