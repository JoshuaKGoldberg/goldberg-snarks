---
import { describeProgress } from "~/graphs/clashes.ts";
import { colorMostEdges, countUncolored } from "~/graphs/colorEdges.ts";
import { createGoldbergGraph } from "~/graphs/createGoldbergGraph.ts";
import {
	drawEdge,
	getRingViewBox,
	getVertexRadius,
	locate,
} from "~/graphs/draw.ts";
import { colorNames } from "~/graphs/edgeClasses.ts";

interface Props {
	blocks: number;
}

const { blocks } = Astro.props;
const graph = createGoldbergGraph(blocks);
const total = graph.edges.length;
const most = total - countUncolored(colorMostEdges(graph));
const id = `puzzle-${blocks.toString()}`;
---

<edge-puzzle class="boxed wide" data-blocks={blocks}>
	<div class="panel">
		<fieldset class="scripted">
			<legend>Color</legend>
			{[...colorNames, "erase"].map((name, i) => (
				<label>
					<input
						autocomplete="off"
						checked={i === 0}
						name={`${id}-color`}
						type="radio"
						value={name}
					/>
					<svg aria-hidden="true" class="graph" viewBox="0 0 28 8">
						<path class={name} d="M2.5 4h23" />
					</svg>
					<span class="name">{name}</span>
				</label>
			))}
		</fieldset>
		<div class="instructions scripted" id={`${id}-instructions`}>
			<p>
				Color as many edges as you can so that edges of the same color never
				meet. Pick a color, then press edges. A vertex turns red if two edges of
				the same color meet there.
			</p>
			<p class="keyboard">
				Keyboard: use the left and right arrow keys to move between edges, and
				the up and down arrow keys to move between blocks. Press{" "}
				{colorNames.map((name, i) => `${(i + 1).toString()} for ${name}, `)}
				or 0 to erase.
			</p>
		</div>
		<noscript>
			<p class="instructions">Coloring edges requires JavaScript.</p>
		</noscript>
	</div>
	<div class="scroller">
		<svg
			aria-describedby={`${id}-instructions`}
			aria-label={`Edges of G${blocks.toString()}`}
			class="graph board"
			role="img"
			style={`--boardWidth: ${(blocks * 2.5).toString()}rem`}
			viewBox={getRingViewBox(5)}
		>
			<path class="halo" />
			{graph.edges.map((_, index) => (
				<path class="edge" d={drawEdge(graph, index)} />
			))}
			<g aria-hidden="true" class="vertices">
				{graph.vertices.map((vertex) => {
					const { x, y } = locate(vertex);

					return <circle cx={x} cy={y} r={getVertexRadius(graph)} />;
				})}
			</g>
		</svg>
	</div>
	<div class="controls scripted">
		<div class="buttons">
			<button class="lights" data-action="undo" disabled type="button">
				Undo
			</button>
			<button class="lights" data-action="reset" type="button">
				Start over
			</button>
			<button class="lights" data-action="best" type="button">
				{`Color ${most.toString()} edges`}
			</button>
		</div>
		<p aria-live="polite" class="status">
			<span class="change visually-hidden"></span>
			<span class="progress">
				{describeProgress(
					graph,
					graph.edges.map(() => undefined),
				)}
			</span>
		</p>
	</div>
</edge-puzzle>

<script>
	import { EdgePuzzle } from "~/scripts/EdgePuzzle.ts";

	customElements.define("edge-puzzle", EdgePuzzle);
</script>

<style>
	@property --green {
		inherits: false;
		initial-value: 0%;
		syntax: "<percentage>";
	}

	@property --blue {
		inherits: false;
		initial-value: 0%;
		syntax: "<percentage>";
	}

	@property --gold {
		inherits: false;
		initial-value: 0%;
		syntax: "<percentage>";
	}

	edge-puzzle {
		display: grid;
		gap: 0.9rem 2rem;
		grid-template: "panel" auto "board" auto "controls" auto / minmax(0, 1fr);
	}

	.panel {
		display: grid;
		gap: 0.75rem;
		grid-area: panel;
	}

	fieldset {
		border: 0;
		display: grid;
		gap: 0.4rem;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 7.5rem), 1fr));
		min-width: 0;
		padding: 0;
	}

	legend {
		font-style: italic;
		margin-bottom: 0.4rem;
		padding: 0;
	}

	label {
		align-items: center;
		background: var(--colorPaper);
		border: 1px solid
			color-mix(in srgb, var(--colorRed) var(--lit), var(--colorRule));
		box-shadow: inset 0 0 0 1px
			color-mix(in srgb, var(--colorRed) var(--lit), transparent);
		cursor: pointer;
		display: flex;
		gap: 0.5rem;
		line-height: 1.2;
		min-height: 2rem;
		padding: 0 0.5rem;
		position: relative;
		transition: --lit var(--quickly);
	}

	.name {
		text-transform: capitalize;
	}

	label:has(:checked) {
		--lit: 100%;
	}

	@media (forced-colors: active) {
		label:has(:checked) {
			outline: 2px solid Highlight;
			outline-offset: -3px;
		}
	}

	label:has(:focus-visible) {
		outline: 2px solid var(--colorRed);
		outline-offset: 2px;
	}

	label .graph {
		flex: none;
		width: 1.75rem;
	}

	label .erase {
		color: var(--colorInkFaint);
	}

	input {
		cursor: pointer;
		inset: 0;
		margin: 0;
		opacity: 0;
		position: absolute;
	}

	.instructions {
		color: var(--colorInkMuted);
		font-size: var(--fontSizeNote);
		line-height: 1.4;
	}

	.keyboard {
		margin-top: 0.4rem;
	}

	@media (hover: none) {
		.keyboard {
			display: none;
		}
	}

	/* Edges of larger snarks would otherwise be too small to tap on smaller screens */
	.scroller {
		grid-area: board;
		margin-inline: -1rem;
		overflow-x: auto;
		overscroll-behavior-x: contain;
		padding: 0.25rem 1rem;
	}

	.board {
		cursor: crosshair;
		margin: auto;
		max-width: 33rem;
		min-width: min(var(--boardWidth), 36rem);
		touch-action: manipulation;
		user-select: none;
	}

	.board .edge {
		color: color-mix(
			in srgb,
			var(--colorGreen) var(--green),
			color-mix(
				in srgb,
				var(--colorBlue) var(--blue),
				color-mix(in srgb, var(--colorGold) var(--gold), var(--colorInkFaint))
			)
		);
		outline: none;
		transition:
			--blue var(--quickly),
			--gold var(--quickly),
			--green var(--quickly),
			stroke-width var(--quickly);
	}

	.board .edge:global([data-color="green"]) {
		--green: 100%;

		stroke-width: 3px;
	}

	.board .edge:global([data-color="blue"]) {
		--blue: 100%;

		stroke-dasharray: 10 6;
		stroke-width: 3.5px;
	}

	.board .edge:global([data-color="gold"]) {
		--gold: 100%;

		stroke-dasharray: 0.1 6;
		stroke-width: 4.5px;
	}

	.board .edge:global([data-near]) {
		stroke-width: 6px;
	}

	.board .edge:focus-visible {
		stroke-width: 6px;
	}

	.halo {
		stroke: var(--colorRed);
		stroke-width: 12px;
	}

	@media (forced-colors: active) {
		.halo {
			stroke: Highlight;
		}
	}

	.vertices {
		color: var(--colorInk);
		pointer-events: none;
	}

	.vertices circle {
		fill: color-mix(in srgb, var(--colorRed) var(--lit), currentcolor);
		stroke: var(--colorRed);
		stroke-width: 0;
		transition:
			--lit var(--quickly),
			stroke-width var(--quickly);
	}

	.vertices circle:global([data-clashing]) {
		--lit: 100%;

		stroke-width: 4px;
	}

	.controls {
		align-content: start;
		display: grid;
		gap: 0.75rem;
		grid-area: controls;
	}

	.status {
		font-size: var(--fontSizeSubheading);
		line-height: 1.3;
		min-height: 3.9em;
	}

	.buttons {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}

	button {
		background: var(--colorPaper);
		border: 1px solid
			color-mix(in srgb, var(--colorRed) var(--lit), var(--colorInkMuted));
		cursor: pointer;
		font: inherit;
		font-size: var(--fontSizeNote);
		line-height: 1.2;
		min-height: 2rem;
		padding: 0 0.7rem;
		transition:
			--lit var(--quickly),
			opacity var(--quickly);
	}

	button:disabled {
		cursor: default;
		opacity: 0.55;
	}

	@media (width >= 60rem) {
		edge-puzzle {
			grid-template:
				"panel board" auto
				"controls board" 1fr / 15rem minmax(0, 1fr);
		}

		.scroller {
			margin: 0;
			padding: 0;
		}
	}

	@media print, (scripting: none) {
		.scripted {
			display: none;
		}
	}

	@media print {
		edge-puzzle {
			break-inside: avoid;
		}
	}
</style>
