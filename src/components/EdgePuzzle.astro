---
import { colorMostEdges } from "~/graphs/colorEdges.ts";
import { createGoldbergGraph } from "~/graphs/createGoldbergGraph.ts";
import {
	drawEdge,
	getRingViewBox,
	getVertexRadius,
	locate,
} from "~/graphs/draw.ts";
import { colorNames } from "~/graphs/edgeClasses.ts";
import { getVertexName } from "~/graphs/getVertexName.ts";

interface Props {
	blocks: number;
}

const { blocks } = Astro.props;
const graph = createGoldbergGraph(blocks);
const solution = colorMostEdges(graph);
const names = graph.vertices.map(getVertexName);
const id = `puzzle-${blocks.toString()}`;
---

<edge-puzzle class="wide">
	<div class="panel">
		<fieldset class="scripted">
			<legend>Color to use</legend>
			{[...colorNames, "erase"].map((name, i) => (
				<label>
					<input
						checked={i === 0}
						name={`${id}-color`}
						type="radio"
						value={name === "erase" ? "" : i}
					/>
					<svg aria-hidden="true" class="graph" viewBox="0 0 42 8">
						<path class={name} d="M2.5 4h37" />
					</svg>
					{name[0].toUpperCase() + name.slice(1)}
				</label>
			))}
		</fieldset>
		<p class="instructions scripted" id={`${id}-instructions`}>
			Pick a color, then <span class="click">click</span>
			<span class="tap">tap</span> edges to color them.{" "}
			<span class="keyboard">
				With a keyboard, the left and right arrow keys move to the next edge,
				and up and down to the same edge of the next block. Then 1, 2, 3, and 0
				color or erase it.
			</span>
		</p>
		<noscript>
			<p class="instructions">Coloring edges here needs JavaScript.</p>
		</noscript>
	</div>
	<div class="scroller">
		<svg
			aria-describedby={`${id}-instructions`}
			aria-label={`Edges of G${blocks.toString()}`}
			class="graph board"
			role="group"
			style={`--boardWidth: ${(blocks * 2.5).toString()}rem`}
			viewBox={getRingViewBox(5)}
		>
			{graph.edges.map(({ from, to }, index) => (
				<path
					aria-label={`Edge ${names[from]} to ${names[to]}: no color`}
					class="edge"
					d={drawEdge(graph, index)}
					data-from={names[from]}
					data-solution={solution[index]}
					data-to={names[to]}
					role="button"
					tabindex={index ? -1 : 0}
				/>
			))}
			<g aria-hidden="true" class="vertices">
				{graph.vertices.map((vertex, index) => {
					const { x, y } = locate(vertex);

					return (
						<circle
							cx={x}
							cy={y}
							data-name={names[index]}
							r={getVertexRadius(graph)}
						/>
					);
				})}
			</g>
		</svg>
	</div>
	<div class="controls scripted">
		<p aria-live="polite" class="status">
			{`0 of ${graph.edges.length.toString()} edges colored.`}
		</p>
		<div class="buttons">
			<button data-action="undo" disabled type="button">
				Undo
			</button>
			<button data-action="reset" type="button">
				Start over
			</button>
			<button data-action="best" type="button">
				Show a best coloring
			</button>
		</div>
	</div>
</edge-puzzle>

<script>
	import { EdgePuzzle } from "~/scripts/EdgePuzzle.ts";

	customElements.define("edge-puzzle", EdgePuzzle);
</script>

<style>
	edge-puzzle {
		background: var(--colorPaperShaded);
		border: 1px solid var(--colorRule);
		border-top: 3px solid var(--colorRed);
		display: grid;
		gap: 0.9rem 2rem;
		grid-template: "panel" auto "board" auto "controls" auto / minmax(0, 1fr);
		margin-block: 1.25rem;
		padding: 1rem;
	}

	.panel {
		display: grid;
		gap: 0.75rem;
		grid-area: panel;
	}

	/* Until it's defined, it can't do anything */
	edge-puzzle:not(:defined) .scripted {
		visibility: hidden;
	}

	@media print, (scripting: none) {
		.scripted {
			display: none;
		}
	}

	fieldset {
		border: 0;
		display: grid;
		gap: 0.4rem;
		grid-template-columns: 1fr 1fr;
		min-width: 0;
		padding: 0;
	}

	legend {
		font-style: italic;
		margin-bottom: 0.4rem;
		padding: 0;
	}

	label {
		align-items: center;
		background: var(--colorPaper);
		border: 1px solid var(--colorRule);
		cursor: pointer;
		display: flex;
		gap: 0.6rem;
		line-height: 1.2;
		min-height: 2.5rem;
		padding: 0 0.75rem;
		position: relative;
	}

	label:has(:checked) {
		border-color: var(--colorRed);
		box-shadow: inset 0 0 0 1px var(--colorRed);
	}

	label:has(:focus-visible) {
		outline: 2px solid var(--colorRed);
		outline-offset: 2px;
	}

	label .graph {
		width: 2.625rem;
	}

	label .erase {
		color: var(--colorInkFaint);
	}

	input {
		cursor: pointer;
		inset: 0;
		margin: 0;
		opacity: 0;
		position: absolute;
	}

	.instructions {
		color: var(--colorInkMuted);
		font-size: 0.9375rem;
		line-height: 1.4;
	}

	.tap {
		display: none;
	}

	@media (hover: none) {
		.click,
		.keyboard {
			display: none;
		}

		.tap {
			display: inline;
		}
	}

	/* Edges of larger snarks would otherwise be too small to tap on smaller screens */
	.scroller {
		grid-area: board;
		margin-inline: -1rem;
		overflow-x: auto;
		overscroll-behavior-x: contain;
		padding: 0.25rem 1rem;
	}

	.board {
		cursor: crosshair;
		margin: auto;
		max-width: 33rem;
		min-width: min(var(--boardWidth), 36rem);
		touch-action: manipulation;
	}

	.board .edge {
		color: var(--colorInkFaint);
		outline: none;
	}

	.board .edge:global([data-color="0"]) {
		color: var(--colorInk);
		stroke-width: 3px;
	}

	.board .edge:global([data-color="1"]) {
		color: var(--colorBlue);
		stroke-dasharray: 10 6;
		stroke-width: 3.5px;
	}

	.board .edge:global([data-color="2"]) {
		color: var(--colorGold);
		stroke-dasharray: 0.1 6;
		stroke-width: 4.5px;
	}

	.board .edge:global([data-near]) {
		stroke-width: 6px;
	}

	.board .edge:focus-visible {
		filter: drop-shadow(0 0 1px var(--colorRed))
			drop-shadow(0 0 2px var(--colorRed));
		stroke-width: 6px;
	}

	.vertices {
		color: var(--colorInk);
		pointer-events: none;
	}

	.vertices :global([data-clashing]) {
		fill: var(--colorRed);
		stroke: var(--colorRed);
		stroke-width: 4px;
	}

	.controls {
		align-content: start;
		display: grid;
		gap: 0.75rem;
		grid-area: controls;
	}

	.status {
		font-size: var(--fontSizeSubheading);
		line-height: 1.3;
		min-height: 2.6em;
	}

	.buttons {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}

	button {
		background: var(--colorPaper);
		border: 1px solid var(--colorInkMuted);
		color: var(--colorInk);
		cursor: pointer;
		font: inherit;
		font-size: 1rem;
		line-height: 1.2;
		min-height: 2.5rem;
		padding: 0 0.9rem;
	}

	button:disabled {
		border-color: var(--colorRule);
		color: var(--colorInkMuted);
		cursor: default;
	}

	button:enabled:hover {
		border-color: var(--colorRed);
		color: var(--colorRed);
	}

	@media (min-width: 60rem) {
		edge-puzzle {
			grid-template:
				"panel board" auto
				"controls board" 1fr / 14rem minmax(0, 1fr);
			padding: 1.25rem;
		}

		.scroller {
			margin: 0;
			padding: 0;
		}
	}
</style>
