---
import { colorMostEdges } from "~/graphs/colorEdges.ts";
import { createGoldbergGraph } from "~/graphs/createGoldbergGraph.ts";
import {
	drawEdge,
	getRingViewBox,
	getVertexRadius,
	locate,
} from "~/graphs/draw.ts";
import { colorNames } from "~/graphs/edgeClasses.ts";
import { getVertexName } from "~/graphs/getVertexName.ts";

interface Props {
	blocks: number;
}

const { blocks } = Astro.props;
const graph = createGoldbergGraph(blocks);
const solution = colorMostEdges(graph);
const names = graph.vertices.map(getVertexName);
const id = `puzzle-${blocks.toString()}`;
---

<edge-puzzle>
	<fieldset class="scripted">
		<legend>Color to use</legend>
		{[...colorNames, "erase"].map((name, i) => (
			<label>
				<input
					checked={i === 0}
					name={`${id}-color`}
					type="radio"
					value={name === "erase" ? "" : i}
				/>
				<svg aria-hidden="true" class="graph" viewBox="0 0 42 8">
					<path class={name} d="M2.5 4h37" />
				</svg>
				{name[0].toUpperCase() + name.slice(1)}
			</label>
		))}
	</fieldset>

	<p class="instructions scripted" id={`${id}-instructions`}>
		Pick a color, then <span class="click">click</span>
		<span class="tap">tap</span> edges to color them.{" "}
		<span class="keyboard">
			With a keyboard, the left and right arrow keys move to the next edge, and
			up and down to the same edge of the next block. Then 1, 2, 3, and 0 color
			or erase it.
		</span>
	</p>
	<noscript>
		<p class="instructions">Coloring edges here needs JavaScript.</p>
	</noscript>

	<div class="scroller">
		<svg
			aria-describedby={`${id}-instructions`}
			aria-label={`Edges of G${blocks.toString()}`}
			class="graph board"
			role="group"
			style={`--boardWidth: ${(blocks * 2.5).toString()}rem`}
			viewBox={getRingViewBox(5)}
		>
			{graph.edges.map(({ from, to }, index) => (
				<path
					aria-label={`Edge ${names[from]} to ${names[to]}: no color`}
					class="edge"
					d={drawEdge(graph, index)}
					data-from={names[from]}
					data-solution={solution[index]}
					data-to={names[to]}
					role="button"
					tabindex={index ? -1 : 0}
				/>
			))}
			<g aria-hidden="true" class="vertices">
				{graph.vertices.map((vertex, index) => {
					const { x, y } = locate(vertex);

					return (
						<circle
							cx={x}
							cy={y}
							data-name={names[index]}
							r={getVertexRadius(graph)}
						/>
					);
				})}
			</g>
		</svg>
	</div>

	<div class="controls scripted">
		<p aria-live="polite" class="status">
			{`0 of ${graph.edges.length.toString()} edges colored.`}
		</p>
		<div class="buttons">
			<button data-action="undo" disabled type="button">
				Undo
			</button>
			<button data-action="reset" type="button">
				Start over
			</button>
			<button data-action="best" type="button">
				Show a best coloring
			</button>
		</div>
	</div>
</edge-puzzle>

<script>
	import { EdgePuzzle } from "~/scripts/EdgePuzzle.ts";

	customElements.define("edge-puzzle", EdgePuzzle);
</script>

<style>
	edge-puzzle {
		background: var(--colorRaised);
		border-radius: 0.5rem;
		box-shadow: inset 0 0 0 1px var(--colorRule);
		display: grid;
		gap: 1rem;
		margin-block: 2rem;
		padding: clamp(1rem, 4vw, 2rem);
	}

	edge-puzzle:not(:defined) .scripted {
		visibility: hidden;
	}

	@media print, (scripting: none) {
		.scripted {
			display: none;
		}
	}

	/* Edges of larger snarks would otherwise be too small to tap on smaller screens */
	.scroller {
		margin-inline: calc(-1 * clamp(1rem, 4vw, 2rem));
		overflow-x: auto;
		overscroll-behavior-x: contain;
		padding: 0.25rem clamp(1rem, 4vw, 2rem);
	}

	fieldset {
		border: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		justify-content: center;
		min-width: 0;
		padding: 0;
	}

	legend {
		clip-path: inset(50%);
		height: 1px;
		overflow: hidden;
		position: absolute;
		white-space: nowrap;
		width: 1px;
	}

	label {
		align-items: center;
		border: 1.5px solid var(--colorRule);
		border-radius: 2rem;
		cursor: pointer;
		display: flex;
		font-family: var(--fontLabel);
		font-size: var(--fontSizeSmall);
		gap: 0.5rem;
		line-height: 1.2;
		min-height: 2.75rem;
		padding: 0 1rem;
		position: relative;
	}

	label:has(:checked) {
		background: var(--colorBackground);
		border-color: var(--colorForeground);
	}

	label:has(:focus-visible) {
		outline: 2px solid var(--colorEmphasized);
		outline-offset: 2px;
	}

	label .graph {
		width: 2.625rem;
	}

	label .erase {
		stroke-dasharray: none;
	}

	input {
		cursor: pointer;
		inset: 0;
		margin: 0;
		opacity: 0;
		position: absolute;
	}

	.instructions {
		color: var(--colorMuted);
		font-size: 0.9em;
		line-height: 1.4;
		text-align: center;
		text-wrap: balance;
	}

	.tap {
		display: none;
	}

	@media (hover: none) {
		.click,
		.keyboard {
			display: none;
		}

		.tap {
			display: inline;
		}
	}

	.board {
		cursor: crosshair;
		margin: auto;
		max-width: max(34rem, var(--boardWidth));
		min-width: min(var(--boardWidth), 36rem);
		touch-action: manipulation;
	}

	.board .edge {
		color: var(--colorMuted);
		outline: none;
	}

	.board .edge:global([data-color]) {
		stroke-width: 3.5px;
	}

	.board .edge:global([data-color="0"]) {
		color: var(--jade);
	}

	.board .edge:global([data-color="1"]) {
		color: var(--cornflower);
		stroke-dasharray: 10 6;
	}

	.board .edge:global([data-color="2"]) {
		color: var(--wisteria);
		stroke-dasharray: 0.1 6;
		stroke-width: 4px;
	}

	.board .edge:global([data-near]) {
		stroke-width: 5px;
	}

	.board .edge:focus-visible {
		filter: drop-shadow(0 0 1.5px var(--colorEmphasized))
			drop-shadow(0 0 1.5px var(--colorEmphasized));
		stroke-width: 6px;
	}

	.vertices {
		color: var(--colorForegroundExtra);
		pointer-events: none;
	}

	.vertices :global([data-clashing]) {
		fill: var(--spare);
		stroke: var(--spare);
		stroke-width: 4px;
	}

	.controls {
		align-items: center;
		display: grid;
		gap: 0.75rem;
		justify-items: center;
	}

	.status {
		font-weight: 500;
		line-height: 1.35;
		min-height: 2.7em;
		text-align: center;
		text-wrap: balance;
	}

	.buttons {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		justify-content: center;
	}

	button {
		background: none;
		border: 1.5px solid var(--colorMuted);
		border-radius: 2rem;
		color: var(--colorForegroundExtra);
		cursor: pointer;
		font-family: var(--fontLabel);
		font-size: var(--fontSizeSmall);
		line-height: 1.2;
		min-height: 2.75rem;
		padding: 0 1.1rem;
	}

	button:disabled {
		border-color: var(--colorRule);
		color: var(--colorMuted);
		cursor: default;
	}

	button:enabled:hover {
		border-color: var(--colorEmphasized);
		color: var(--colorEmphasized);
	}
</style>
