---
import { author, source } from "~/constants.ts";
---

<footer>
	<p>
		Compiled by <a href={author}>Josh Goldberg</a>. Its drawings, and most of
		its numbers, are computed by <a href={source}>its source</a>.
	</p>
</footer>

<style>
	footer {
		border-top: 1px solid var(--colorRule);
		color: var(--colorInkMuted);
		font-size: var(--fontSizeSmall);
		font-style: italic;
		margin-top: 4rem;
		padding: 1.25rem var(--space) 2.5rem;
		text-align: center;
		text-wrap: balance;
	}

	@media print {
		footer {
			margin-top: 1rem;
			padding-bottom: 0;
		}
	}
</style>
