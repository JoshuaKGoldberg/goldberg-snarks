---
interface Props {
	id: string;
}
---

<a class="lights self-link" href={`#${Astro.props.id}`}>
	<slot />
</a>

<style>
	.self-link {
		text-decoration: none;
	}

	.self-link::after {
		color: var(--colorRed);
		content: "#" / "";
		opacity: 0;
		margin-right: -1em;
		padding-left: 0.2em;
		transition: opacity var(--quickly);
	}

	:global(:target) > .self-link {
		--lit: 100%;
	}

	.self-link:focus-visible::after,
	:global(:target) > .self-link::after {
		opacity: 1;
	}

	@media (hover: hover) {
		.self-link:hover::after {
			opacity: 1;
		}
	}
</style>
