---
import HeroDrawing from "./HeroDrawing.astro";

interface Props {
	blocks: number;

	/** Whether to show how close three colors get to being enough. */
	colored?: boolean;
}

const { blocks, colored } = Astro.props;
---

<div class="hero">
	<div class="words">
		<slot />
	</div>
	<HeroDrawing blocks={blocks} colored={colored} />
</div>

<style>
	.hero {
		align-items: center;
		display: grid;
		margin-inline: auto;
		max-width: var(--widthText);
		gap: 2.5rem clamp(2rem, 6vw, 5rem);
		padding-block: clamp(1rem, 4vw, 3rem) clamp(3rem, 8vw, 6rem);
	}

	.words > :global(p) {
		font-size: var(--fontSizeSubtitle);
		line-height: 1.35;
		margin-top: 1.25rem;
		max-width: 26em;
		text-wrap: pretty;
	}

	@media (min-width: 60rem) {
		.hero {
			max-width: none;
			grid-template-columns: minmax(0, 1fr) minmax(0, 30rem);
		}
	}
</style>
