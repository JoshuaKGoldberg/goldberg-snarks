---
import { colorNames } from "~/graphs/edgeClasses.ts";

interface Props {
	/** Whether there are edges that three colors weren't enough for. */
	spare?: boolean;
}

const names = [...colorNames, ...(Astro.props.spare ? ["spare"] : [])];
---

<ul aria-label="Key">
	{names.map((name) => (
		<li>
			<svg aria-hidden="true" class="graph" viewBox="0 0 42 8">
				<path class={name} d="M2.5 4h37" />
			</svg>
			{name === "spare" ? "uncolored" : name}
		</li>
	))}
</ul>

<style>
	ul {
		display: flex;
		flex-wrap: wrap;
		font-size: 0.875rem;
		gap: 0.1rem 1rem;
		justify-content: center;
		line-height: 1.4;
		list-style: none;
		padding: 0;
	}

	li {
		align-items: center;
		display: flex;
		gap: 0.4rem;
	}

	.graph {
		width: 2.625rem;
	}
</style>
