---
interface Props {
	headings: { slug: string; text: string }[];
}
---

<ol>
	{Astro.props.headings.map(({ slug, text }) => (
		<li>
			<a class="link" href={`#${slug}`}>
				{text}
			</a>
		</li>
	))}
</ol>

<style>
	ol {
		counter-reset: link;
		list-style: none;
		padding: 0;
	}

	li {
		counter-increment: link;
	}

	.link {
		color: var(--colorInkMuted);
		display: grid;
		font-size: 0.9375rem;
		gap: 0.6em;
		grid-template-columns: 1em 1fr;
		line-height: 1.25;
		padding-block: 0.3rem;
		text-decoration: none;
	}

	.link::before {
		color: var(--colorRed);
		content: counter(link);
	}

	.link:hover,
	.link:global([aria-current]) {
		color: var(--colorRed);
	}

	.link:global([aria-current]) {
		font-style: italic;
	}
</style>
