---
/** What's first in this is beside the rest if there's room for it to be, or after it if not. */
---

<div class="annotated">
	<slot />
</div>

<style>
	.annotated > :global(p) {
		margin-top: 0.7rem;
	}

	@media screen and (max-width: 59.99rem) {
		.annotated {
			display: flex;
			flex-direction: column;
		}

		.annotated > :global(:first-child) {
			order: 1;
		}
	}
</style>
