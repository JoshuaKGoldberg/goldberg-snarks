---
import type { MarkdownHeading } from "astro";

import Contents from "./Contents.astro";

interface Props {
	headings: Pick<MarkdownHeading, "depth" | "slug" | "text">[];
}

const headings = Astro.props.headings.filter(({ depth }) => depth === 2);
---

<div class:list={["page", headings.length > 0 && "with-contents"]}>
	{headings.length > 0 && (
		<nav aria-label="On this page" class="beside" data-contents>
			<Contents headings={headings} />
		</nav>
	)}
	<article>
		<slot name="heading" />
		{headings.length > 0 && (
			<nav aria-label="On this page" class="above">
				<details>
					<summary>Contents</summary>
					<Contents headings={headings} />
				</details>
			</nav>
		)}
		<slot />
	</article>
</div>

<script>
	import { markContents } from "~/scripts/markContents.ts";

	markContents();
</script>

<style>
	.page {
		--outset: 0px;

		padding-top: 2rem;
	}

	.beside {
		display: none;
	}

	.above {
		border-block: 1px solid var(--colorRule);
		margin-block: 1.5rem;
		padding-block: 0.4rem;
	}

	summary {
		font-style: italic;
	}

	article {
		counter-reset: figure section;
		min-width: 0;
	}

	article :global(h2) {
		counter-increment: section;
		margin-block: 2.25rem 0.6rem;
	}

	article :global(h2)::before {
		color: var(--colorRed);
		content: counter(section);
		margin-right: 0.6em;
	}

	article :global(.wide) {
		clear: both;
		margin-right: calc(-1 * var(--outset));
	}

	article :global(h3) {
		margin: 1.75rem 0 0.4rem;
	}

	article > :global(:is(p, ul, ol):not([class])),
	article :global(.annotated > p) {
		margin-top: 0.7rem;
	}

	article :global(:is(h2, h3) + p),
	article :global(.annotated > :is(h2, h3) + p),
	article > :global(:is(h2, h3) + .annotated > :first-child + p) {
		margin-top: 0;
	}

	/* Puts what's beside the text first on wide screens after it on narrow ones */
	@media screen and (width < 60rem) {
		article :global(.annotated) {
			display: flex;
			flex-direction: column;
			margin-bottom: 1.25rem;
			reading-flow: flex-visual;
		}

		article :global(.annotated > :first-child:is(div, figure)) {
			margin-bottom: 0;
			order: 1;
		}

		article :global(.annotated > h2) {
			margin-top: 0;
		}
	}

	article :global(.pair) {
		column-gap: 1.5rem;
		display: grid;
		grid-template-columns: minmax(0, 1fr);
	}

	article :global(.pair figure) {
		grid-row: span 3;
		grid-template-rows: subgrid;
	}

	@media (width >= 40rem) {
		article :global(.pair) {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	article > :global(ul:not([class])) {
		display: grid;
		gap: 0.4rem;
		padding-left: 1.2rem;
	}

	article > :global(ul:not([class])) :global(::marker) {
		color: var(--colorRed);
	}

	article :global(.nowrap) {
		white-space: nowrap;
	}

	article :global(.table) {
		margin-block: 1.1rem;
		overflow-x: auto;
	}

	article :global(table) {
		border-bottom: 1px solid var(--colorInk);
		border-collapse: collapse;
		border-top: 1px solid var(--colorInk);
		font-size: var(--fontSizeNote);
		font-feature-settings: "lnum", "tnum";
		line-height: 1.35;
		width: 100%;
	}

	article :global(:is(td, th)) {
		border-bottom: 1px solid var(--colorRule);
		font-weight: inherit;
		padding: 0.32rem 0.9rem 0.32rem 0;
		text-align: left;
		text-wrap: pretty;
		vertical-align: baseline;
	}

	article :global(tbody tr:last-child > *) {
		border-bottom: 0;
	}

	article :global(thead th) {
		border-bottom: 1px solid var(--colorInk);
		color: var(--colorRed);
		font-style: italic;
		vertical-align: bottom;
	}

	article :global(dl) {
		display: grid;
		gap: 0.55rem;
	}

	article > :global(dl) :global(dt) {
		font-weight: 700;
	}

	article > :global(dl) :global(dd) {
		margin: 0 0 0.25rem 1.2rem;
	}

	@media (width >= 60rem) {
		.page {
			--outset: calc(var(--widthMargin) + var(--gap));

			padding-right: var(--outset);
		}
	}

	@media (width >= 75rem) {
		.with-contents {
			column-gap: var(--gap);
			display: grid;
			grid-template-columns: var(--widthContents) minmax(0, 1fr);
		}

		article {
			grid-column: 2;
			grid-row: 1;
		}

		.beside {
			align-self: start;
			display: block;
			max-height: calc(100vh - 1rem);
			overflow-y: auto;
			padding-block: 0.5rem 2rem;
			position: sticky;
			top: 1rem;
		}

		.above {
			display: none;
		}
	}

	@media print {
		article :global(:is(h2, h3)) {
			break-after: avoid;
		}

		.above,
		.beside {
			display: none;
		}
	}
</style>
