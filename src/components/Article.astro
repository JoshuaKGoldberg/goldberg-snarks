---
import type { MarkdownHeading } from "astro";

import Contents from "./Contents.astro";

interface Props {
	headings: Pick<MarkdownHeading, "depth" | "slug" | "text">[];
}

const headings = Astro.props.headings.filter(({ depth }) => depth === 2);
---

<div class="article">
	<nav aria-label="On this page" class="beside" data-contents>
		<Contents headings={headings} />
	</nav>
	<details class="above">
		<summary>On this page</summary>
		<Contents headings={headings} />
	</details>
	<article>
		<slot />
	</article>
</div>

<script>
	import { markContents } from "~/scripts/markContents.ts";

	markContents();
</script>

<style>
	.article {
		margin-inline: auto;
		max-width: var(--widthText);
	}

	.beside {
		display: none;
	}

	.above {
		margin-bottom: 3rem;
	}

	summary {
		cursor: pointer;
		font-family: var(--fontLabel);
		font-size: var(--fontSizeSmall);
		padding-block: 0.6rem;
	}

	article {
		max-width: var(--widthText);
		min-width: 0;
	}

	article :global(h2) {
		margin-block: var(--spaceSection) 1.25rem;
	}

	article :global(h2:first-child) {
		margin-top: 0;
	}

	article :global(h3) {
		margin: 2.5rem 0 0.75rem;
	}

	article > :global(:is(p, ul) + :is(p, ul)) {
		margin-top: 1.1rem;
	}

	article > :global(ul:not([class])) {
		display: grid;
		gap: 0.6rem;
		padding-left: 1.25rem;
	}

	article :global(.table) {
		margin-block: 1.5rem;
		overflow-x: auto;
	}

	article :global(table) {
		border-collapse: collapse;
		font-size: 0.9em;
		line-height: 1.4;
		width: 100%;
	}

	article :global(:is(td, th)) {
		border-bottom: 1px solid var(--colorRule);
		font-weight: inherit;
		padding: 0.6rem 1rem 0.6rem 0;
		text-align: left;
		text-wrap: pretty;
		vertical-align: baseline;
	}

	article :global(thead th) {
		color: var(--colorMuted);
		font-family: var(--fontLabel);
		font-size: var(--fontSizeSmall);
	}

	article :global(dt) {
		color: var(--colorForegroundExtra);
		font-weight: 600;
	}

	article :global(dd) {
		margin: 0.35rem 0 1.25rem;
	}

	@media (min-width: 60rem) {
		.article {
			display: grid;
			gap: clamp(3rem, 6vw, 5rem);
			grid-template-columns: 11rem minmax(0, var(--widthText));
			max-width: none;
		}

		.beside {
			align-self: start;
			display: block;
			max-height: 100vh;
			overflow-y: auto;
			padding-block: 0.5rem 2rem;
			position: sticky;
			top: 1.5rem;
		}

		.above {
			display: none;
		}
	}

	@media print {
		.above,
		.beside {
			display: none;
		}
	}
</style>
