---
import type { ComponentProps } from "astro/types";

import type { MovableGraph } from "~/scripts/MovableDrawing.ts";

import { groupDots, groupEdges, locate } from "~/graphs/draw.ts";

import Drawing from "./Drawing.astro";

type Props = ComponentProps<typeof Drawing> & {
	/** Tells apart the controls of drawings on the same page. */
	name: string;
};

/** Depth that's neither toward nor away from the viewer. */
const middleDepth = 0.58;

/** How many times deeper the graph is than its depths, so that turning it shows more. */
const deepening = 170;

const { name, ...drawing } = Astro.props;
const { edgeClass, graph, vertexClass } = drawing;

const data = {
	dots: groupDots(graph, vertexClass).map(([, indices]) => indices),
	edges: groupEdges(graph, edgeClass).map(([, indices]) =>
		indices.map((index) => [graph.edges[index].from, graph.edges[index].to]),
	),
	names: graph.vertices.map(({ name }) => name),
	points: graph.vertices.map((vertex) => {
		const { x, y } = locate(vertex);
		const { depth = middleDepth } = vertex;

		return [x, y, Math.round((depth - middleDepth) * deepening)];
	}),
} satisfies MovableGraph;

const isDeep = data.points.some(([, , z]) => z !== 0);
---

<movable-drawing
	data-deep={isDeep || undefined}
	data-graph={JSON.stringify(data)}
>
	<Drawing {...drawing}>
		<circle class="marker near" />
		<circle class="marker selected" />
	</Drawing>
	<div aria-label={name} class="buttons" role="toolbar">
		<span class="movers">
			<button
				class="lights"
				data-action="next"
				title="Press to select each vertex in turn, then use arrow keys to move it."
				type="button"
			>
				Select
			</button>
			{isDeep && (
				<button
					class="lights"
					data-action="turn"
					title="Press to turn it, or use arrow keys."
					type="button"
				>
					Turn
				</button>
			)}
		</span>
		<button class="lights" data-action="reset" disabled type="button">
			Reset
		</button>
		<span class="visually-hidden" role="status"></span>
	</div>
</movable-drawing>

<script>
	import { MovableDrawing } from "~/scripts/MovableDrawing.ts";

	customElements.define("movable-drawing", MovableDrawing);
</script>

<style>
	movable-drawing {
		display: block;
	}

	movable-drawing :global(svg) {
		touch-action: pan-y pinch-zoom;
		-webkit-user-select: none;
		user-select: none;
	}

	movable-drawing[data-deep] :global(svg) {
		cursor: grab;
	}

	movable-drawing[data-near] :global(svg) {
		cursor: move;
	}

	movable-drawing[data-moving] :global(svg) {
		cursor: grabbing;
	}

	movable-drawing .marker {
		fill: none;
		opacity: 0;
		pointer-events: none;
		r: calc(var(--dot) / 2 + 2.5px);
		stroke: var(--colorRed);
		stroke-width: 1px;
		transition: opacity var(--quickly);
	}

	movable-drawing .marker[data-shown] {
		opacity: 1;
	}

	movable-drawing .selected {
		stroke-width: 2px;
	}

	.buttons {
		display: grid;
		gap: 0.25rem;
		grid-template-columns: 1fr auto 1fr;
		justify-items: start;
		min-height: 1.5rem;
		position: relative;
	}

	.movers {
		display: flex;
		gap: 0.25rem;
		grid-column: 2;
	}

	button {
		--resting: var(--colorInkMuted);

		background: none;
		border: 0;
		cursor: pointer;
		font: inherit;
		font-size: var(--fontSizeSmall);
		font-style: italic;
		line-height: 1;
		min-height: 1.5rem;
		min-width: 2.5rem;
		padding: 0 0.4rem;
		text-decoration: underline 1px;
		text-underline-offset: 0.2em;
		touch-action: manipulation;
		transition:
			--lit var(--quickly),
			opacity var(--quickly),
			visibility var(--quickly);
	}

	/* Its space is kept, so that other buttons stay put */
	button:disabled {
		opacity: 0;
		visibility: hidden;
	}

	@media print, (scripting: none) {
		.buttons {
			display: none;
		}
	}
</style>
