---
import type { ComponentProps } from "astro/types";

import { locate } from "~/graphs/draw.ts";

import Drawing from "./Drawing.astro";

type Props = ComponentProps<typeof Drawing> & {
	/** Tells apart the buttons of drawings on the same page. */
	name: string;
};

/** Depth that's neither toward nor away from the viewer. */
const middleDepth = 0.58;

/** How many times deeper the graph is than its depths, so that turning it shows more. */
const deepening = 170;

const { name, ...drawing } = Astro.props;
const { edgeClass = () => "plain", graph, vertexClass } = drawing;

// Grouped in the same order as they're drawn in
const group = (names: string[]) => {
	const groups = new Map<string, number[]>();

	for (const [index, name] of names.entries()) {
		groups.set(name, [...(groups.get(name) ?? []), index]);
	}

	return [...groups.values()];
};

const data = {
	edges: group(graph.edges.map((_, index) => edgeClass(index))).map((indices) =>
		indices.map((index) => [graph.edges[index].from, graph.edges[index].to]),
	),
	points: graph.vertices.map((vertex) => {
		const { x, y } = locate(vertex);
		const z = vertex.depth
			? Math.round((vertex.depth - middleDepth) * deepening)
			: 0;

		return [x, y, z];
	}),
	vertices: group(
		graph.vertices.map((vertex, index) =>
			vertex.role === "stub" ? "stub" : `dots ${vertexClass?.(index) ?? ""}`,
		),
	).filter(([index]) => graph.vertices[index].role !== "stub"),
};

const isDeep = data.points.some(([, , z]) => z !== 0);
---

<movable-drawing
	data-deep={isDeep || undefined}
	data-graph={JSON.stringify(data)}
>
	<Drawing {...drawing} />
	<div class="buttons">
		{isDeep && (
			<button aria-label={`Turn: ${name}`} data-action="turn" type="button">
				Turn
			</button>
		)}
		<button
			aria-label={`Reset: ${name}`}
			data-action="reset"
			disabled
			type="button"
		>
			Reset
		</button>
	</div>
</movable-drawing>

<script>
	import { MovableDrawing } from "~/scripts/MovableDrawing.ts";

	customElements.define("movable-drawing", MovableDrawing);
</script>

<style>
	movable-drawing {
		display: block;
	}

	/* Vertical swipes still scroll the page, except for on vertices */
	movable-drawing[data-deep] :global(svg) {
		cursor: grab;
		touch-action: pan-y;
		user-select: none;
	}

	movable-drawing[data-moving] :global(svg) {
		cursor: grabbing;
	}

	movable-drawing :global(.handle) {
		cursor: move;
		fill: transparent;
	}

	movable-drawing :global(.handle:hover) {
		stroke: var(--colorRed);
		stroke-width: 1px;
	}

	movable-drawing :global(.handle[data-selected]) {
		stroke: var(--colorRed);
		stroke-width: 2px;
	}

	/* Names would no longer be beside what they name */
	movable-drawing[data-moved] :global(text) {
		opacity: 0;
	}

	.buttons {
		display: flex;
		gap: 0.25rem;
		justify-content: center;
		min-height: 1.5rem;
	}

	movable-drawing:not(:defined) .buttons {
		visibility: hidden;
	}

	button {
		background: none;
		border: 0;
		color: var(--colorInkMuted);
		cursor: pointer;
		font: inherit;
		font-size: 0.875rem;
		font-style: italic;
		line-height: 1;
		min-height: 1.5rem;
		min-width: 2.5rem;
		padding: 0 0.4rem;
		text-decoration: underline 1px;
		text-decoration-color: var(--colorRule);
		text-underline-offset: 0.2em;
	}

	button:hover {
		color: var(--colorRed);
	}

	/* Its space is kept, so that other buttons stay put */
	button:disabled {
		visibility: hidden;
	}

	@media print, (scripting: none) {
		.buttons {
			display: none;
		}
	}
</style>
