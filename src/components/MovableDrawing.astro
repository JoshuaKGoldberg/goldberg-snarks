---
import type { ComponentProps } from "astro/types";

import { locate } from "~/graphs/draw.ts";

import Drawing from "./Drawing.astro";

type Props = ComponentProps<typeof Drawing>;

/** Depth that's neither toward nor away from the viewer. */
const middleDepth = 0.58;

/** How many times deeper the graph is than its depths, so that turning it shows more. */
const deepening = 170;

const { cropped, edgeClass = () => "plain", graph, vertexClass } = Astro.props;

// Grouped in the same order as they're drawn in
const group = (names: string[]) => {
	const groups = new Map<string, number[]>();

	for (const [index, name] of names.entries()) {
		groups.set(name, [...(groups.get(name) ?? []), index]);
	}

	return [...groups.values()];
};

const data = {
	edges: group(graph.edges.map((_, index) => edgeClass(index))).map((indices) =>
		indices.map((index) => [graph.edges[index].from, graph.edges[index].to]),
	),
	points: graph.vertices.map((vertex) => {
		const { x, y } = locate(vertex);
		const z = vertex.depth
			? Math.round((vertex.depth - middleDepth) * deepening)
			: 0;

		return [x, y, z];
	}),
	vertices: group(
		graph.vertices.map((vertex, index) =>
			vertex.role === "stub" ? "stub" : `dots ${vertexClass?.(index) ?? ""}`,
		),
	).filter(([index]) => graph.vertices[index].role !== "stub"),
};
---

<movable-drawing data-graph={JSON.stringify(data)}>
	<Drawing {...Astro.props} />
	<div class="buttons">
		{!cropped && (
			<button data-action="turn" type="button">
				Turn<span class="hidden"> drawing</span>
			</button>
		)}
		<button data-action="reset" disabled type="button">
			Reset<span class="hidden"> drawing</span>
		</button>
	</div>
</movable-drawing>

<script>
	import { MovableDrawing } from "~/scripts/MovableDrawing.ts";

	customElements.define("movable-drawing", MovableDrawing);
</script>

<style>
	movable-drawing {
		cursor: grab;
		display: block;
		position: relative;
	}

	movable-drawing:global([data-moving]) {
		cursor: grabbing;
	}

	/* Vertical swipes still scroll the page, except for on vertices */
	movable-drawing :global(svg) {
		touch-action: pan-y;
		user-select: none;
	}

	movable-drawing :global(svg:focus) {
		outline: none;
	}

	movable-drawing :global(svg:focus-visible) {
		outline: 2px solid var(--colorRed);
	}

	movable-drawing :global(.handle) {
		cursor: move;
		fill: transparent;
		touch-action: none;
	}

	movable-drawing :global(.handle:hover) {
		stroke: var(--colorRed);
		stroke-width: 1px;
	}

	movable-drawing :global(.handle[data-selected]) {
		stroke: var(--colorRed);
		stroke-width: 2px;
	}

	/* Names would no longer be beside what they name */
	movable-drawing:global([data-moved]) :global(text) {
		opacity: 0;
	}

	.buttons {
		bottom: 0;
		display: flex;
		gap: 0.25rem;
		opacity: 0;
		position: absolute;
		right: 0;
	}

	movable-drawing:is(:hover, :focus-within) .buttons {
		opacity: 1;
	}

	@media (hover: none) {
		.buttons {
			opacity: 1;
		}
	}

	movable-drawing:not(:defined) .buttons {
		display: none;
	}

	button {
		background: var(--colorPaper);
		border: 1px solid var(--colorRule);
		color: var(--colorInkMuted);
		cursor: pointer;
		font: inherit;
		font-size: 0.875rem;
		font-style: italic;
		line-height: 1;
		min-height: 1.75rem;
		padding: 0 0.5rem;
	}

	button:hover {
		border-color: var(--colorRed);
		color: var(--colorRed);
	}

	button:disabled {
		visibility: hidden;
	}

	.hidden {
		clip-path: inset(50%);
		height: 1px;
		overflow: hidden;
		position: absolute;
		white-space: nowrap;
		width: 1px;
	}

	@media print, (scripting: none) {
		.buttons {
			display: none;
		}
	}
</style>
