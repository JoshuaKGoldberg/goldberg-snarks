---
import { Code as HighlightedCode } from "astro:components";

interface Props {
	/** Whether lines may be broken anywhere. */
	breaks?: boolean;
	code: string;
	lang?: "bibtex" | "plaintext" | "python";
}

const { breaks, code, lang = "plaintext" } = Astro.props;
---

<div class:list={["code", breaks && "breaks"]}>
	<HighlightedCode code={code.trimEnd()} lang={lang} theme="css-variables" />
</div>

<style>
	.code {
		--astro-code-background: var(--colorPaperShaded);
		--astro-code-foreground: var(--colorInk);
		--astro-code-token-comment: var(--colorInkMuted);
		--astro-code-token-constant: var(--colorBlue);
		--astro-code-token-function: var(--colorBlue);
		--astro-code-token-keyword: var(--colorRed);
		--astro-code-token-link: var(--colorBlue);
		--astro-code-token-parameter: var(--colorInk);
		--astro-code-token-punctuation: var(--colorInkMuted);
		--astro-code-token-string: var(--colorGoldText);
		--astro-code-token-string-expression: var(--colorGoldText);

		margin-block: 0.9rem;
	}

	.code :global(pre) {
		border-left: 3px solid var(--colorRule);
		font-size: var(--fontSizeSmall);
		line-height: 1.5;
		max-height: 24rem;
		overflow: auto;
		padding: 0.7rem 1rem;
		tab-size: 4;
	}

	.breaks :global(pre) {
		overflow-wrap: anywhere;
		white-space: pre-wrap;
	}
</style>
