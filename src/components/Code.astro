---
interface Props {
	/** Whether lines may be broken anywhere. */
	breaks?: boolean;
	code: string;
}

const { breaks, code } = Astro.props;
---

{/* Anything that scrolls needs to be focusable to be scrolled with a keyboard */}
{/* eslint-disable-next-line astro/jsx-a11y/no-noninteractive-tabindex */}
<pre class:list={[breaks && "breaks"]} tabindex="0"><code>{code}</code></pre>

<style>
	pre {
		background: var(--colorRaised);
		border-radius: 0.5rem;
		box-shadow: inset 0 0 0 1px var(--colorRule);
		font-size: 0.875rem;
		line-height: 1.5;
		margin-block: 1rem;
		max-height: 16rem;
		overflow: auto;
		padding: 1rem 1.25rem;
	}

	.breaks {
		overflow-wrap: anywhere;
		white-space: pre-wrap;
	}
</style>
