---
interface Props {
	/** Whether lines may be broken anywhere. */
	breaks?: boolean;
	code: string;
}

const { breaks, code } = Astro.props;
---

{/* Anything that scrolls needs to be focusable to be scrolled with a keyboard */}
{/* eslint-disable-next-line astro/jsx-a11y/no-noninteractive-tabindex */}
<pre class:list={[breaks && "breaks"]} tabindex="0"><code>{code}</code></pre>

<style>
	pre {
		background: var(--colorPaperShaded);
		border-left: 3px solid var(--colorRule);
		font-size: 0.8125rem;
		line-height: 1.45;
		margin-block: 0.9rem;
		max-height: 22rem;
		overflow: auto;
		padding: 0.7rem 1rem;
		tab-size: 4;
	}

	.breaks {
		overflow-wrap: anywhere;
		white-space: pre-wrap;
	}
</style>
