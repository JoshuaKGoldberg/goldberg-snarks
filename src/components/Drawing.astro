---
import type { Graph } from "~/graphs/types.ts";

import { stub } from "~/graphs/createBlockChain.ts";
import {
	drawEdge,
	drawEdgesByClass,
	getCroppedViewBox,
	getRingViewBox,
	getVertexRadius,
	locate,
} from "~/graphs/draw.ts";
import { getDistances, getNeighbors } from "~/graphs/measure.ts";

interface Props {
	/** Whether the graph is of a shape other than a ring around its center. */
	cropped?: boolean;

	/** Classes for each edge, by index. */
	edgeClass?: (index: number) => string;

	graph: Graph;

	/** Whether edges draw themselves in, outward from the center. */
	grows?: boolean;

	/** What the drawing shows, or nothing if what's beside it already says. */
	label?: string | undefined;

	/** Names of vertices to show by index, and where to from each, in units. */
	names?: (
		index: number,
	) => readonly [name: string, x: number, y: number] | undefined;

	/** How big names are, in units. */
	nameSize?: number;

	padding?: number;

	/** Classes for each vertex, by index. */
	vertexClass?: ((index: number) => string | undefined) | undefined;
}

const {
	cropped,
	edgeClass = () => "plain",
	graph,
	grows,
	label,
	names,
	nameSize = 9,
	padding = 5,
	vertexClass,
} = Astro.props;

const distances = grows ? getDistances(getNeighbors(graph), 0) : [];
const dots = new Map<string, string>();

// Dots are zero-length lines with round ends, which makes for much less markup
for (const [index, vertex] of graph.vertices.entries()) {
	if (vertex.role !== stub) {
		const { x, y } = locate(vertex);
		const name = vertexClass?.(index) ?? "";

		dots.set(name, `${dots.get(name) ?? ""}M${x.toString()} ${y.toString()}h0`);
	}
}

const texts = names
	? graph.vertices.flatMap((vertex, index) => {
			const name = names(index);
			const { x, y } = locate(vertex);

			return name
				? [
						{
							letter: name[0].slice(0, 1),
							number: name[0].slice(1),
							x: x + name[1],
							y: y + name[2],
						},
					]
				: [];
		})
	: [];

const accessibility = label
	? ({ "aria-label": label, role: "img" } as const)
	: ({ "aria-hidden": true } as const);

const dotSize = (getVertexRadius(graph) * 2).toFixed(1);
---

<svg
	class:list={["graph", grows && "grows"]}
	style={`--dot: ${dotSize}px; --name: ${nameSize.toString()}px`}
	viewBox={
		cropped ? getCroppedViewBox(graph, padding) : getRingViewBox(padding)
	}
	{...accessibility}
>
	{grows
		? graph.edges.map(({ from, to }, index) => (
				<path
					class={edgeClass(index)}
					d={drawEdge(graph, index)}
					pathLength="1"
					style={`--step: ${Math.min(distances[from], distances[to]).toString()}`}
				/>
			))
		: drawEdgesByClass(graph, edgeClass).map(([name, path]) => (
				<path class={name} d={path} />
			))}
	{[...dots].map(([name, path]) => (
		<path class:list={["dots", name]} d={path} />
	))}
	{texts.map(({ letter, number, x, y }) => (
		<text x={x.toFixed(1)} y={y.toFixed(1)}>
			{letter}
			{number && <tspan dy="0.2em">{number}</tspan>}
		</text>
	))}
</svg>

<style>
	.graph .dots {
		stroke: var(--colorForegroundExtra);
		stroke-width: var(--dot);
		vector-effect: none;
	}

	.graph .dots.faint {
		stroke: var(--colorFaint);
	}

	text {
		fill: currentcolor;
		font-family: var(--fontText);
		font-size: var(--name);
		font-style: italic;
		font-weight: 450;
		text-anchor: middle;
	}

	tspan {
		font-size: 0.7em;
		font-style: normal;
	}

	/* Dashes are only measured correctly in strokes that scale */
	.grows path:not(.dots) {
		stroke-width: 1.1px;
		vector-effect: none;
	}

	.grows path.spoke {
		stroke-width: 0.8px;
	}

	.grows path.spare {
		stroke-width: 2.8px;
	}

	.grows path.blue {
		stroke-dasharray: 0.16 0.09;
	}

	.grows path.purple {
		stroke-dasharray: 0.001 0.08;
		stroke-width: 1.4px;
	}

	@media (prefers-reduced-motion: no-preference) {
		.grows path:not(.dots) {
			animation: grow 700ms calc(var(--step) * 170ms) ease-in-out backwards;
		}

		.grows .dots {
			animation: appear 1.6s ease-in backwards;
		}
	}

	@keyframes appear {
		from {
			opacity: 0;
		}
	}

	@keyframes grow {
		from {
			stroke-dasharray: 1 1;
			stroke-dashoffset: 1;
		}

		99% {
			stroke-dasharray: 1 1;
			stroke-dashoffset: 0;
		}
	}

	@media print {
		.grows path {
			animation: none !important;
		}
	}
</style>
