---
import type { Graph } from "~/graphs/types.ts";

import {
	drawDot,
	drawEdge,
	getCroppedViewBox,
	getRingViewBox,
	getVertexRadius,
	groupDots,
	groupEdges,
	locate,
} from "~/graphs/draw.ts";

interface Props {
	/** Whether the graph is of a shape other than a ring around its center. */
	cropped?: boolean;

	/** Classes for each edge, by index. */
	edgeClass: (index: number) => string;

	graph: Graph;

	/** What the drawing shows, or nothing if what's beside it already says. */
	label?: string;

	/** Names of vertices to show by index, and where to from each, in units. */
	names?: (
		index: number,
	) => readonly [name: string, x: number, y: number] | undefined;

	/** How big names are, in units. */
	nameSize?: number;

	padding?: number;

	/** Classes for each vertex, by index. */
	vertexClass?: (index: number) => string | undefined;
}

const {
	cropped,
	edgeClass,
	graph,
	label,
	names,
	nameSize = 9,
	padding = 5,
	vertexClass,
} = Astro.props;

const texts = names
	? graph.vertices.flatMap((vertex, index) => {
			const name = names(index);
			const { x, y } = locate(vertex);

			return name
				? [
						{
							index,
							letter: name[0].slice(0, 1),
							number: name[0].slice(1),
							x: x + name[1],
							y: y + name[2],
						},
					]
				: [];
		})
	: [];

const accessibility = label
	? ({ "aria-label": label, role: "img" } as const)
	: ({ "aria-hidden": true } as const);

const dotSize = (getVertexRadius(graph) * 2).toFixed(1);
---

<svg
	class="graph"
	style={`--dot: ${dotSize}px; --name: ${nameSize.toString()}px`}
	viewBox={
		cropped ? getCroppedViewBox(graph, padding) : getRingViewBox(padding)
	}
	{...accessibility}
>
	{groupEdges(graph, edgeClass).map(([name, indices]) => (
		<path
			class={name}
			d={indices.map((index) => drawEdge(graph, index)).join("")}
		/>
	))}
	{groupDots(graph, vertexClass).map(([name, indices]) => (
		<path
			class:list={["dots", name]}
			d={indices.map((index) => drawDot(graph.vertices[index])).join("")}
		/>
	))}
	{texts.map(({ index, letter, number, x, y }) => (
		<text data-vertex={index} x={x.toFixed(1)} y={y.toFixed(1)}>
			{letter}
			{number && <tspan dy="0.2em">{number}</tspan>}
		</text>
	))}
	<slot />
</svg>

<style>
	.graph .dots {
		stroke: var(--colorInk);
		stroke-width: var(--dot);
		vector-effect: none;
	}

	.graph .dots.faint {
		stroke: var(--colorInkFaint);
	}

	text {
		fill: currentcolor;
		font-family: var(--fontText);
		font-size: var(--name);
		font-style: italic;
		text-anchor: middle;
	}

	tspan {
		font-size: 0.7em;
		font-style: normal;
	}
</style>
