<button aria-label="Dark theme" class="theme-toggle" type="button">
	<svg aria-hidden="true" height="22" viewBox="0 0 24 24" width="22">
		<circle cx="12" cy="12" r="8.5"></circle>
		<path d="M12 3.5a8.5 8.5 0 0 1 0 17z"></path>
	</svg>
</button>

<script>
	import { query } from "~/scripts/query.ts";
	import { startThemeToggle } from "~/scripts/startThemeToggle.ts";

	startThemeToggle(query(document, ".theme-toggle", HTMLElement));
</script>

<style>
	button {
		background: none;
		border: 0;
		color: inherit;
		cursor: pointer;
		grid-area: toggle;
		padding: 0.5rem;
	}

	/* Needs JavaScript to do anything, which is also what sets its state */
	button:not([aria-pressed]) {
		visibility: hidden;
	}

	button:hover {
		color: var(--colorEmphasized);
	}

	circle {
		fill: none;
		stroke: currentcolor;
		stroke-width: 1.75;
	}

	path {
		fill: currentcolor;
	}

	@media print {
		button {
			display: none;
		}
	}
</style>
