---
interface Props {
	id?: string;
	kind: "Corollary" | "Definition" | "Lemma" | "Theorem";
	name?: string;
	number: number;
}

const { id, kind, name, number } = Astro.props;
---

<div class:list={["statement", kind.toLowerCase()]} id={id}>
	<p class="head">
		{id ? (
			<a class="anchor" href={`#${id}`}>
				<strong>{`${kind} ${number.toString()}`}</strong>
			</a>
		) : (
			<strong>{`${kind} ${number.toString()}`}</strong>
		)}
		{name && ` (${name})`}.
	</p>
	<slot />
</div>

<style>
	.statement {
		background: var(--colorPaperShaded);
		border-left: 3px solid var(--colorRed);
		margin-block: 1.1rem;
		padding: 0.6rem 1rem 0.7rem;
	}

	.statement:not(.definition) > :global(:not(.head)) {
		font-style: italic;
	}

	/* Emphasis within what's already italic */
	.statement:not(.definition) > :global(:not(.head)) :global(em) {
		font-style: normal;
	}

	.statement > :global(ul) {
		padding-left: 1.2rem;
	}

	.anchor {
		text-decoration: none;
	}

	.anchor:hover {
		text-decoration: underline;
	}

	.anchor::after {
		content: "\00a0#" / "";
		display: none;
	}

	.anchor:is(:hover, :focus-visible)::after,
	.statement:target .anchor::after {
		display: inline;
	}

	.statement:target {
		box-shadow: 0 0 0 1px var(--colorRed);
	}

	strong {
		color: var(--colorRed);
		font-weight: 700;
	}

	.statement > :global(* + :not(.formulas + .formulas, .head + p)) {
		margin-top: 0.4rem;
	}
</style>
