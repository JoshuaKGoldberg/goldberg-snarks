---
import { getStatement, type StatementId } from "~/statements.ts";

import SelfLink from "./SelfLink.astro";

interface Props {
	id: StatementId;
	name?: string;
}

const { id, name } = Astro.props;
const { kind, label } = getStatement(id);
---

<div
	aria-labelledby={`${id}-label`}
	class:list={["statement", kind.toLowerCase()]}
	id={id}
	role="group"
>
	<p class="head">
		<SelfLink id={id}>
			<strong id={`${id}-label`}>{label}</strong>
			{name && ` (${name})`}.
		</SelfLink>
	</p>
	<slot />
</div>

<style>
	.statement {
		background: var(--colorPaperShaded);
		border-left: 3px solid var(--colorRed);
		margin-block: 1.1rem;
		padding: 0.6rem 1rem 0.7rem;
	}

	.statement:not(.definition) > :global(:not(.head)) {
		font-style: italic;
	}

	.statement:not(.definition) > :global(:not(.head)) :global(em) {
		font-style: normal;
	}

	.statement > :global(ul) {
		padding-left: 1.2rem;
	}

	.statement:target {
		outline: 1px solid var(--colorRed);
	}

	strong {
		color: var(--colorRed);
		font-weight: 700;
	}

	.statement > :global(* + *) {
		margin-top: 0.4rem;
	}

	.statement > :global(.head + p) {
		margin-top: 0;
	}

	@media print {
		.statement {
			break-inside: avoid;
		}
	}
</style>
