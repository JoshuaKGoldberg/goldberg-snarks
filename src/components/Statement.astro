---
interface Props {
	id?: string;
	kind: "Corollary" | "Definition" | "Lemma" | "Theorem";
	name?: string;
	number: number;
}

const { id, kind, name, number } = Astro.props;
---

<div class="statement" id={id}>
	<p class="head">
		<strong>
			{kind} {number}
		</strong>
		{name && ` (${name})`}
	</p>
	<slot />
</div>

<style>
	.statement {
		background: var(--colorRaised);
		border-radius: 0.5rem;
		box-shadow: inset 0 0 0 1px var(--colorRule);
		margin-block: 2rem;
		padding: 1.25rem 1.5rem 1.4rem;
	}

	.head {
		color: var(--colorForegroundExtra);
		margin-bottom: 0.4rem;
	}

	.statement > :global(* + :not(.formulas + .formulas, .head + p)) {
		margin-top: 0.75rem;
	}

	strong {
		font-weight: 600;
	}
</style>
