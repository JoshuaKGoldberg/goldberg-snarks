---
interface Props {
	id?: string;
	kind: "Corollary" | "Definition" | "Lemma" | "Theorem";
	name?: string;
	number: number;
}

const { id, kind, name, number } = Astro.props;
---

<div class:list={["statement", kind.toLowerCase()]} id={id}>
	<p class="head">
		<strong>
			{kind} {number}
		</strong>
		{name && ` (${name})`}.
	</p>
	<slot />
</div>

<style>
	.statement {
		background: var(--colorPaperShaded);
		border-left: 3px solid var(--colorRed);
		margin-block: 1.1rem;
		padding: 0.6rem 1rem 0.7rem;
	}

	.statement:not(.definition) > :global(:not(.head)) {
		font-style: italic;
	}

	/* Emphasis within what's already italic */
	.statement:not(.definition) > :global(:not(.head)) :global(em) {
		font-style: normal;
	}

	strong {
		color: var(--colorRed);
		font-weight: 700;
	}

	.statement > :global(* + :not(.formulas + .formulas, .head + p)) {
		margin-top: 0.4rem;
	}
</style>
