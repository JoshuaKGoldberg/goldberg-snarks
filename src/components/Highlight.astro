---
import { createGoldbergGraph } from "~/graphs/createGoldbergGraph.ts";
import { getHighlight, type HighlightKind } from "~/graphs/highlights.ts";

import Figure from "./Figure.astro";
import MovableDrawing from "./MovableDrawing.astro";

interface Props {
	blocks: number;
	kind: HighlightKind;
	label: string;
}

const { blocks, kind, label } = Astro.props;

const names: Record<HighlightKind, string> = {
	"block-cycles": "Cycles of lengths 5 and 6 in",
	"every-fifth": "Every fifth block of",
	"every-third": "Every third block of",
	farthest: "Shortest path in",
	inner: "Inner ring of",
	longest: "Longest cycle of",
	swapped: "Outer and middle rings of",
};

const graph = createGoldbergGraph(blocks);
const { edgeClass, vertexClass } = getHighlight(graph, kind);
---

<Figure>
	<MovableDrawing
		edgeClass={edgeClass}
		graph={graph}
		label={label}
		name={`${names[kind]} G${blocks.toString()}`}
		slot="drawing"
		vertexClass={vertexClass}
	/>
	<slot />
</Figure>
