---
import { colorEdges } from "~/graphs/colorEdges.ts";
import { createGoldbergGraph } from "~/graphs/createGoldbergGraph.ts";
import { getColorClass } from "~/graphs/edgeClasses.ts";

import Drawing from "./Drawing.astro";

const blocks = 6;
const graph = createGoldbergGraph(blocks);
const coloring = colorEdges(graph);
---

<block-explorer class="wide">
	<div class="picture">
		<Drawing
			edgeClass={(index) => getColorClass(coloring?.[index])}
			graph={graph}
		/>
	</div>
	<div class="slider">
		<label for="explorer-blocks">Number of blocks</label>
		<input
			id="explorer-blocks"
			max="15"
			min="4"
			step="1"
			type="range"
			value={blocks}
		/>
		<output for="explorer-blocks">
			<strong>{blocks} blocks</strong>
			<span>All {graph.edges.length} edges can be colored.</span>
		</output>
	</div>
</block-explorer>

<script>
	import { BlockExplorer } from "~/scripts/BlockExplorer.ts";

	customElements.define("block-explorer", BlockExplorer);
</script>

<style>
	block-explorer {
		align-items: center;
		background: var(--colorPaperShaded);
		border: 1px solid var(--colorRule);
		border-top: 3px solid var(--colorRed);
		display: grid;
		gap: 1rem 2rem;
		margin-block: 1.25rem;
		padding: 1rem;
	}

	.picture {
		margin-inline: auto;
		max-width: 27rem;
		width: 100%;
	}

	block-explorer:not(:defined) .slider {
		visibility: hidden;
	}

	@media print, (scripting: none) {
		.slider {
			display: none;
		}
	}

	.slider {
		display: grid;
		gap: 0.6rem;
	}

	label {
		font-style: italic;
	}

	input {
		accent-color: var(--colorRed);
		cursor: pointer;
		height: 1.75rem;
		width: 100%;
	}

	output {
		display: grid;
		line-height: 1.4;
		min-height: 4.2em;
	}

	output :global(strong) {
		font-size: var(--fontSizeHeading);
		font-weight: 400;
	}

	@media (min-width: 60rem) {
		block-explorer {
			grid-template-columns: minmax(0, 1fr) 16rem;
			padding: 1.25rem;
		}
	}

	@media print {
		block-explorer {
			break-inside: avoid;
		}
	}
</style>
