---
import { colorEdges } from "~/graphs/colorEdges.ts";
import { createGoldbergGraph } from "~/graphs/createGoldbergGraph.ts";
import { getColorClass } from "~/graphs/edgeClasses.ts";

import Drawing from "./Drawing.astro";

const blocks = 6;
const graph = createGoldbergGraph(blocks);
const coloring = colorEdges(graph);
---

<block-explorer>
	<div class="picture">
		<Drawing
			edgeClass={(index) => getColorClass(coloring?.[index])}
			graph={graph}
			padding={4}
		/>
	</div>
	<div class="slider">
		<label for="explorer-blocks">Number of blocks</label>
		<input
			id="explorer-blocks"
			max="15"
			min="3"
			step="1"
			type="range"
			value={blocks}
		/>
		<output for="explorer-blocks">
			<strong>6 blocks.</strong> Three colors are enough for all 72 edges.
		</output>
	</div>
</block-explorer>

<script>
	import { BlockExplorer } from "~/scripts/BlockExplorer.ts";

	customElements.define("block-explorer", BlockExplorer);
</script>

<style>
	block-explorer {
		background: var(--colorRaised);
		border-radius: 0.5rem;
		box-shadow: inset 0 0 0 1px var(--colorRule);
		display: grid;
		gap: 1.5rem;
		margin-block: 2rem;
		padding: clamp(1rem, 4vw, 2rem);
	}

	.picture {
		margin-inline: auto;
		max-width: 26rem;
		width: 100%;
	}

	block-explorer:not(:defined) .slider {
		visibility: hidden;
	}

	.slider {
		display: grid;
		gap: 0.75rem;
		margin-inline: auto;
		max-width: 26rem;
		text-align: center;
		width: 100%;
	}

	label {
		color: var(--colorMuted);
		font-family: var(--fontLabel);
		font-size: var(--fontSizeSmall);
	}

	input {
		accent-color: var(--colorEmphasized);
		cursor: pointer;
		height: 1.75rem;
		width: 100%;
	}

	output {
		line-height: 1.4;
		min-height: 2.8em;
		text-wrap: balance;
	}

	output :global(strong) {
		font-weight: 600;
	}
</style>
