---
import { colorMostEdges } from "~/graphs/colorEdges.ts";
import { createGoldbergGraph } from "~/graphs/createGoldbergGraph.ts";
import { describeColoring } from "~/graphs/describeColoring.ts";
import { getColorClass } from "~/graphs/edgeClasses.ts";

import ColoringKey from "./ColoringKey.astro";
import Drawing from "./Drawing.astro";

interface Props {
	blocks: number;
	max: number;
	min: number;
}

const { blocks, max, min } = Astro.props;
const graph = createGoldbergGraph(blocks);
const coloring = colorMostEdges(graph);
---

<block-explorer class="boxed wide">
	<div class="picture">
		<Drawing
			edgeClass={(index) => getColorClass(coloring[index])}
			graph={graph}
		/>
		<ColoringKey spare />
	</div>
	<div class="slider">
		<label for="explorer-blocks">Number of blocks</label>
		<input
			id="explorer-blocks"
			max={max}
			min={min}
			step="1"
			type="range"
			value={blocks}
		/>
		<output for="explorer-blocks">
			<span class="count">{blocks} blocks</span>
			<span class="result">{describeColoring(coloring)}</span>
		</output>
	</div>
</block-explorer>

<script>
	import { BlockExplorer } from "~/scripts/BlockExplorer.ts";

	customElements.define("block-explorer", BlockExplorer);
</script>

<style>
	block-explorer {
		align-items: center;
		display: grid;
		gap: 1rem 2rem;
	}

	.picture {
		display: grid;
		gap: 0.6rem;
		margin-inline: auto;
		max-width: 27rem;
		width: 100%;
	}

	.slider {
		display: grid;
		gap: 0.6rem;
	}

	label {
		font-style: italic;
	}

	input {
		cursor: pointer;
		height: 1.75rem;
		width: 100%;
	}

	/* Browsers' own would switch between themes all at once */
	@media not (forced-colors: active) {
		input {
			--thumb: 1.125rem;
			--track: 4px;

			appearance: none;
			background: none;
		}

		input::-webkit-slider-runnable-track {
			background: var(--colorInkFaint);
			border-radius: var(--track);
			height: var(--track);
		}

		input::-moz-range-track {
			background: var(--colorInkFaint);
			border-radius: var(--track);
			height: var(--track);
		}

		input::-webkit-slider-thumb {
			appearance: none;
			background: var(--colorRed);
			border-radius: 50%;
			height: var(--thumb);
			margin-top: calc((var(--track) - var(--thumb)) / 2);
			width: var(--thumb);
		}

		input::-moz-range-thumb {
			background: var(--colorRed);
			border: 0;
			border-radius: 50%;
			height: var(--thumb);
			width: var(--thumb);
		}
	}

	output {
		display: grid;
		align-content: start;
		line-height: 1.4;
		min-height: 5em;
	}

	.count {
		font-size: var(--fontSizeHeading);
	}

	@media (width >= 60rem) {
		block-explorer {
			grid-template-columns: minmax(0, 1fr) 16rem;
		}
	}

	@media print {
		block-explorer {
			break-inside: avoid;
		}
	}

	@media print, (scripting: none) {
		.slider > :not(output) {
			display: none;
		}
	}
</style>
