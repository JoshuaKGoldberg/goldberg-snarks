---
/** Words that are colored as whatever they're describing is in drawings. */
interface Props {
	is: "blue" | "gold" | "hub" | "middle" | "outer" | "spare";
}
---

<span class:list={["term", Astro.props.is]}>
	<slot />
</span>

<style>
	.term {
		border-bottom: 2px solid var(--line);
	}

	.blue,
	.outer {
		--line: var(--colorBlue);
	}

	.gold,
	.middle {
		--line: var(--colorGold);
	}

	.blue {
		border-bottom-style: dashed;
	}

	.gold {
		border-bottom: 3px dotted var(--line);
	}

	.hub,
	.spare {
		--line: var(--colorRed);
	}

	.spare {
		border-bottom-width: 4px;
	}
</style>
