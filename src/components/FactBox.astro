---
import { createGoldbergGraph } from "~/graphs/createGoldbergGraph.ts";
import { getPartClass } from "~/graphs/edgeClasses.ts";

import MovableDrawing from "./MovableDrawing.astro";

interface Props {
	blocks: number;

	kind: string;
}

const { blocks, kind } = Astro.props;
const graph = createGoldbergGraph(blocks);
---

<div class="boxed fact-box in-margin">
	<MovableDrawing
		edgeClass={(index) => getPartClass(graph, index)}
		graph={graph}
		label={`The ${kind} G${blocks.toString()}: ${blocks.toString()} identical blocks in a ring, with an inner ring through one vertex of each.`}
		name={`${kind} G${blocks.toString()}`}
		padding={4}
	/>
	<p class="caption">
		<slot name="caption" />
		<br />
		<span class="hint">
			<span class="pointer">Drag to turn it, or drag a vertex to move it.</span>
			<span class="touch">
				Swipe sideways to turn it. Tap a vertex, then drag it or tap a new
				place, to move it.
			</span>
		</span>
	</p>
	<table>
		<tbody>
			<slot />
		</tbody>
	</table>
</div>

<style>
	.fact-box {
		display: grid;
		gap: 0.5rem;
		grid-template-columns: minmax(0, 1fr);
	}

	.fact-box > :global(movable-drawing) {
		margin-inline: auto;
		max-width: 22rem;
		width: 100%;
	}

	.caption {
		color: var(--colorInkMuted);
		font-size: var(--fontSizeSmall);
		font-style: italic;
		line-height: 1.35;
		text-align: center;
		text-wrap: balance;
	}

	.fact-box table {
		border: 0;
		border-top: 1px solid var(--colorInk);
		font-size: var(--fontSizeNote);
	}

	.fact-box :global(th) {
		overflow-wrap: anywhere;
		color: var(--colorInkMuted);
	}

	.fact-box :global(td) {
		padding-right: 0;
		text-align: right;
	}

	.fact-box :global(:is(td, th)) {
		padding-block: 0.22rem;
	}

	.touch {
		display: none;
	}

	@media (hover: none) {
		.pointer {
			display: none;
		}

		.touch {
			display: inline;
		}
	}

	@media print, (scripting: none) {
		.hint {
			display: none;
		}
	}

	@media print {
		.fact-box {
			float: right;
			margin: 0 0 1rem 1.5rem;
			width: 15rem;
		}
	}
</style>
