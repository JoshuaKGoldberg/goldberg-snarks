---
import { getPath } from "~/getPath.ts";
import { getSnarks } from "~/getSnarks.ts";

import Snark from "./Snark.astro";
import ThemeToggle from "./ThemeToggle.astro";

const path = getPath(Astro.url);
const snarks = await getSnarks();
---

<header>
	<div class="inside">
		<a aria-current={path === "/" ? "page" : undefined} class="home" href="/">
			Goldberg Snarks
		</a>
		<nav aria-label="Snarks">
			<ul>
				{snarks.map(({ blocks, href }) => (
					<li>
						<a
							aria-current={path === href ? "page" : undefined}
							class="snark-link"
							href={href}
						>
							<Snark n={blocks} />
						</a>
					</li>
				))}
			</ul>
		</nav>
		<ThemeToggle />
	</div>
</header>

<style>
	/* A double rule, as around the title pages of old books */
	header {
		border-bottom: 1px solid var(--colorRule);
		border-top: 4px solid var(--colorRed);
	}

	.inside {
		align-items: center;
		column-gap: 1.5rem;
		display: flex;
		flex-wrap: wrap;
		margin-inline: auto;
		max-width: calc(var(--widthFull) + 2 * var(--space));
		padding: 0.35rem var(--space);
	}

	.home,
	.snark-link {
		color: var(--colorInk);
		line-height: 2.25rem;
		text-decoration: none;
	}

	.home {
		font-size: 1.1875rem;
		font-style: italic;
		margin-right: auto;
	}

	ul {
		display: flex;
		list-style: none;
		padding: 0;
	}

	.snark-link {
		border-bottom: 2px solid transparent;
		display: block;
		min-width: 2.5rem;
		padding: 0 0.45rem;
		text-align: center;
	}

	.home:hover,
	.snark-link:hover,
	[aria-current="page"] {
		color: var(--colorRed);
	}

	.snark-link[aria-current="page"] {
		border-color: var(--colorRed);
	}

	@media (max-width: 40rem) {
		nav {
			order: 1;
			width: 100%;
		}

		ul {
			justify-content: space-between;
			margin-inline: -0.45rem;
		}

		.snark-link {
			min-width: 0;
		}
	}

	@media print {
		nav {
			display: none;
		}
	}
</style>
