---
import { siteName } from "~/constants.ts";
import { getSnarks } from "~/getGraphs.ts";
import { getPath } from "~/getPath.ts";

import Snark from "./Snark.astro";
import ThemeToggle from "./ThemeToggle.astro";

const path = getPath(Astro.url);
const snarks = await getSnarks();
---

<header>
	<div class="inside">
		<a
			aria-current={path === "/" ? "page" : undefined}
			class="home lights"
			href="/"
		>
			{siteName}
		</a>
		<nav aria-label="Snarks">
			<ul>
				{snarks.map(({ blocks, href }) => (
					<li>
						<a
							aria-current={path === href ? "page" : undefined}
							class="lights snark-link"
							href={href}
						>
							<Snark n={blocks} />
						</a>
					</li>
				))}
			</ul>
		</nav>
		<ThemeToggle />
	</div>
</header>

<style>
	header {
		border-bottom: 1px solid var(--colorRule);
		border-top: 4px solid var(--colorRed);
	}

	.inside {
		align-items: center;
		column-gap: 1.5rem;
		display: flex;
		flex-wrap: wrap;
		margin-inline: auto;
		max-width: calc(var(--widthPage) + 2 * var(--space));
		padding: 0.35rem var(--space);
	}

	.home,
	.snark-link {
		line-height: 2.25rem;
		text-decoration: none;
	}

	.home {
		font-size: var(--fontSizeSubheading);
		font-style: italic;
		flex: 1;
	}

	ul {
		display: flex;
		flex-wrap: wrap;
		list-style: "";
		padding: 0;
	}

	.snark-link {
		display: block;
		min-width: 2.5rem;
		padding: 0 0.45rem 2px;
		text-align: center;
	}

	.snark-link[aria-current="page"] {
		border-bottom: 2px solid var(--colorRed);
		padding-bottom: 0;
	}

	@media (width <= 40rem) {
		.inside {
			padding-top: 0.9rem;
		}

		nav {
			order: 1;
			width: 100%;
		}

		ul {
			justify-content: space-between;
			margin-inline: -0.45rem;
		}

		.snark-link {
			min-width: 0;
		}
	}

	@media print {
		nav {
			display: none;
		}
	}
</style>
