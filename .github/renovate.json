{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"automerge": true,
	"extends": [
		":preserveSemverRanges",
		"config:best-practices",
		"replacements:all"
	],
	"labels": ["dependencies"],
	"minimumReleaseAge": "7 days",
	"packageRules": [
		{
			"description": "The age in config:best-practices would otherwise override the top-level one.",
			"matchDatasources": ["npm"],
			"matchUpdateTypes": ["major", "minor", "patch"],
			"minimumReleaseAge": "7 days"
		},
		{
			"description": "The Engines Check job's Node.js version is the minimum from engines.node.",
			"enabled": false,
			"matchDepNames": ["node"],
			"matchFileNames": [".github/workflows/ci.yaml"]
		}
	],
	"patch": { "enabled": false },
	"postUpdateOptions": ["pnpmDedupe"]
}
